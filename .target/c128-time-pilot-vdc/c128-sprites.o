
{
    "target_platform": {
        "platform": "C128",
        "cpu": "mos6502x"
    },
    "asm_upstart": ".file [name=\"PALSPRITE01.BIN\", type=\"bin\", segments=\"palettes\"]\r\n.segmentdef Program [segments=\"Basic, Code, Data\"]\r\n.segmentdef Basic [start=$0801]\r\n.segmentdef Code [start=$1c0e]\r\n.segmentdef Data [startAfter=\"Code\"]\r\n.segment Basic\r\n:BasicUpstart(main)\r\n.segmentdef palettes\r\n.segment palettes\r\n",
    "zp_reserved": [
        0,
        1,
        252,
        253,

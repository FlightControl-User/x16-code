            "asm_end": "  // [584] if(gotoxy::x#0>=*((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_WIDTH)) goto gotoxy::@1 -- vbuaa_ge__deref_pbuc1_then_la1 \n  cmp __conio+OFFSET_STRUCT___CX16_CONIO_S_WIDTH\n  bcs __b1\n  // [586] phi from gotoxy gotoxy::@1 to gotoxy::@2 [phi:gotoxy/gotoxy::@1->gotoxy::@2]\n  // [586] phi gotoxy::$3 = gotoxy::x#0 [phi:gotoxy/gotoxy::@1->gotoxy::@2#0] -- register_copy \n  jmp __b2\n  // gotoxy::@1\n__b1:\n  // [585] gotoxy::$2 = *((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_WIDTH) -- vbuaa=_deref_pbuc1 \n  lda __conio+OFFSET_STRUCT___CX16_CONIO_S_WIDTH\n  // gotoxy::@2\n__b2:\n  // [587] *((char *)&__conio) = gotoxy::$3 -- _deref_pbuc1=vbuaa \n  sta __conio\n  // [588] if(gotoxy::y#0>=*((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_HEIGHT)) goto gotoxy::@3 -- vbuyy_ge__deref_pbuc1_then_la1 \n  cpy __conio+OFFSET_STRUCT___CX16_CONIO_S_HEIGHT\n  bcs __b3\n  // gotoxy::@4\n  // [589] gotoxy::$14 = gotoxy::y#0 -- vbuaa=vbuyy \n  tya\n  // [590] phi from gotoxy::@3 gotoxy::@4 to gotoxy::@5 [phi:gotoxy::@3/gotoxy::@4->gotoxy::@5]\n  // [590] phi gotoxy::$7 = gotoxy::$6 [phi:gotoxy::@3/gotoxy::@4->gotoxy::@5#0] -- register_copy \n  // gotoxy::@5\n__b5:\n  // [591] *((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_CURSOR_Y) = gotoxy::$7 -- _deref_pbuc1=vbuaa \n  sta __conio+OFFSET_STRUCT___CX16_CONIO_S_CURSOR_Y\n  // [592] gotoxy::$8 = *((char *)&__conio) << 1 -- vbuxx=_deref_pbuc1_rol_1 \n  lda __conio\n  asl\n  tax\n  // [593] gotoxy::$10 = gotoxy::y#0 << 1 -- vbuaa=vbuyy_rol_1 \n  tya\n  asl\n  // [594] gotoxy::$9 = ((unsigned int *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_OFFSETS)[gotoxy::$10] + gotoxy::$8 -- vwum1=pwuc1_derefidx_vbuaa_plus_vbuxx \n  tay\n  txa\n  clc\n  adc __conio+OFFSET_STRUCT___CX16_CONIO_S_OFFSETS,y\n  sta gotoxy__9\n  lda __conio+OFFSET_STRUCT___CX16_CONIO_S_OFFSETS+1,y\n  adc #0\n  sta gotoxy__9+1\n  // [595] *((unsigned int *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_OFFSET) = gotoxy::$9 -- _deref_pwuc1=vwum1 \n  lda g
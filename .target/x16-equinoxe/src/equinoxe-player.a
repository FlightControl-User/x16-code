.segment Code
  // textcolor
// Set the front color for text output. The old front text color setting is returned.
// - color: a 4 bit value ( decimal between 0 and 15).
//   This will only work when the VERA is in 16 color mode!
//   Note that on the VERA, the transparent color has value 0.
// char textcolor(char color)
textcolor: {
    // constants
    // variables
    // variables-zero-page
    // __conio.color & 0xF0
    // [177] textcolor::$0 = *((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR) & $f0 -- vbuaa=_deref_pbuc1_band_vbuc2 
    lda #$f0
    and __conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR
    // __conio.color & 0xF0 | color
    // [178] textcolor::$1 = textcolor::$0 | WHITE -- vbuaa=vbuaa_bor_vbuc1 
    ora #WHITE
    // __conio.color = __conio.color & 0xF0 | color
    // [179] *((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR) = textcolor::$1 -- _deref_pbuc1=vbuaa 
    sta __conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR
    // textcolor::@return
    // }
    // [180] return 
    rts
}
  // code segment

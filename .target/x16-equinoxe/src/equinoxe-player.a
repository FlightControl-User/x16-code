    // __conio.color & 0x0F
    // [181] bgcolor::$0 = *((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR) & $f -- vbuaa=_deref_pbuc1_band_vbuc2 
    lda #$f

.segment Code
  // __equinoxe_player_start
// void equinoxe_player.__equinoxe_player_start()
__equinoxe_player_start: {
    // constants
    // variables
    // variables-zero-page
    // __equinoxe_player_start::__init1
    // __export volatile __address(0x00) unsigned char BRAM = 0
    // [1] BRAM = 0 -- vbuz1=0 
    stz.z BRAM
    // __export volatile __address(0x01) unsigned char BROM = 4
    // [2] BROM = 4 -- vbuz1=vbuc1 
    lda #4
    sta.z BROM
    // __equinoxe_player_start::@return
    // [3] return 
    rts
}
  // code segment
.segment Code
  // player_logic
// void equinoxe_player.player_logic(__mem() unsigned int mouse_x, __mem() unsigned int mouse_px, __mem() unsigned int mouse_y, __mem() char mouse_status)
player_logic: {
    // constants
    // variables
    // variables-zero-page
    // flight_index_t p = flight_root(FLIGHT_PLAYER)
    // [24] flight_root::type = 0 -- vbum1=0 
    stz equinoxe_flightengine.flight_root.type
    // [25] callexecute flight_root  -- call_var_near 
    jsr equinoxe_flightengine.flight_root
    // [26] player_logic::p#0 = flight_root::return -- vbum1=vbum2 
    lda equinoxe_flightengine.flight_root.return
    sta p
    // [27] phi from player_logic player_logic::@3 to player_logic::@1 [phi:player_logic/player_logic::@3->player_logic::@1]
    // [27] phi player_logic::p#10 = player_logic::p#0 [phi:player_logic/player_logic::@3->player_logic::@1#0] -- register_copy 
    // player_logic::@1
  __b1:
    // while(p)
    // [28] if(0!=player_logic::p#10) goto player_logic::@2 -- 0_neq_vbum1_then_la1 
    lda p
    bne __b2
    // player_logic::@return
    // }
    // [29] return 
    rts
    // player_logic::@2
  __b2:
    // flight_index_t pn = flight_next(p)
    // [30] flight_next::i = player_logic::p#10 -- vbum1=vbum2 
    lda p
    sta equinoxe_flightengine.flight_next.i
    // [31] callexecute flight_next  -- call_var_near 
    jsr equinoxe_flightengine.flight_next
    // [32] player_logic::p#1 = flight_next::return -- vbum1=vbum2 
    lda equinoxe_flightengine.flight_next.return
    sta p_1
    // if (flight.type[p] == FLIGHT_PLAYER && flight.used[p])
    // [33] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_TYPE)[player_logic::p#10]!=0) goto player_logic::@3 -- pbuc1_derefidx_vbum1_neq_0_then_la1 
    ldy p
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_TYPE,y
    cmp #0
    bne __b3
    // player_logic::@15
    // [34] if(0!=((char *)&flight+OFFSET_STRUCT_FLIGHT_T_USED)[player_logic::p#10]) goto player_logic::@13 -- 0_neq_pbuc1_derefidx_vbum1_then_la1 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_USED,y
    cmp #0
    bne __b13
    // player_logic::@3
  __b3:
    // [35] player_logic::p#16 = player_logic::p#1 -- vbum1=vbum2 
    lda p_1
    sta p
    bra __b1
    // player_logic::@13
  __b13:
    // if (flight.reload[p] > 0)
    // [36] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_RELOAD)[player_logic::p#10]<=0) goto player_logic::@4 -- pbuc1_derefidx_vbum1_le_0_then_la1 
    ldy p
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_RELOAD,y
    cmp #0
    beq __b4
    // player_logic::@14
    // flight.reload[p]--;
    // [37] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_RELOAD)[player_logic::p#10] = -- ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_RELOAD)[player_logic::p#10] -- pbuc1_derefidx_vbum1=_dec_pbuc1_derefidx_vbum1 
    ldx p
    dec equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_RELOAD,x
    // player_logic::@4
  __b4:
    // if (mouse_status == 1 && flight.reload[p] <= 0)
    // [38] if(player_logic::mouse_status!=1) goto player_logic::@5 -- vbum1_neq_vbuc1_then_la1 
    lda #1
    cmp mouse_status
    bne __b5
    // player_logic::@16
    // [39] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_RELOAD)[player_logic::p#10]<=0) goto player_logic::@9 -- pbuc1_derefidx_vbum1_le_0_then_la1 
    ldy p
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_RELOAD,y
    cmp #0
    bne !__b9+
    jmp __b9
  !__b9:
    // player_logic::@5
  __b5:
    // flight.xi[p] = (unsigned int)mouse_x
    // [40] player_logic::$25 = player_logic::p#10 << 1 -- vbuxx=vbum1_rol_1 
    lda p
    asl
    tax
    // [41] ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[player_logic::$25] = player_logic::mouse_x -- pwuc1_derefidx_vbuxx=vwum1 
    lda mouse_x
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,x
    lda mouse_x+1
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,x
    // flight.yi[p] = (unsigned int)mouse_y
    // [42] ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[player_logic::$25] = player_logic::mouse_y -- pwuc1_derefidx_vbuxx=vwum1 
    lda mouse_y
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,x
    lda mouse_y+1
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,x
    // flight_index_t n = flight.engine[p]
    // [43] player_logic::n#0 = ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_ENGINE)[player_logic::p#10] -- vbum1=pbuc1_derefidx_vbum2 
    ldy p
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_ENGINE,y
    sta n
    // flight.xi[p]+8
    // [44] player_logic::$15 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[player_logic::$25] + 8 -- vwum1=pwuc1_derefidx_vbuxx_plus_vbuc2 
    lda #8
    clc
    adc equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,x
    sta player_logic__15
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,x
    adc #0
    sta player_logic__15+1
    // flight.xi[n] = flight.xi[p]+8
    // [45] player_logic::$29 = player_logic::n#0 << 1 -- vbuyy=vbum1_rol_1 
    lda n
    asl
    tay
    // [46] ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[player_logic::$29] = player_logic::$15 -- pwuc1_derefidx_vbuyy=vwum1 
    lda player_logic__15
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,y
    lda player_logic__15+1
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,y
    // flight.yi[p]+32
    // [47] player_logic::$16 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[player_logic::$25] + $20 -- vwum1=pwuc1_derefidx_vbuxx_plus_vbuc2 
    lda #$20
    clc
    adc equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,x
    sta player_logic__16
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,x
    adc #0
    sta player_logic__16+1
    // flight.yi[n] = flight.yi[p]+32
    // [48] ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[player_logic::$29] = player_logic::$16 -- pwuc1_derefidx_vbuyy=vwum1 
    lda player_logic__16
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,y
    lda player_logic__16+1
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,y
    // unsigned int x = flight.xi[p]
    // [49] player_logic::x1#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[player_logic::$25] -- vwum1=pwuc1_derefidx_vbuxx 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,x
    sta x1
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,x
    sta x1+1
    // unsigned int y = flight.yi[p]
    // [50] player_logic::y1#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[player_logic::$25] -- vwum1=pwuc1_derefidx_vbuxx 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,x
    sta y1
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,x
    sta y1+1
    // if (x > 640 - 32)
    // [51] if(player_logic::x1#0<=$280-$20) goto player_logic::@7 -- vwum1_le_vwuc1_then_la1 
    lda x1+1
    cmp #>$280-$20
    bne !+
    lda x1
    cmp #<$280-$20
  !:
    // [52] phi from player_logic::@5 to player_logic::@11 [phi:player_logic::@5->player_logic::@11]
    // player_logic::@11
    // player_logic::@7
    // if (y > 480 - 32)
    // [53] if(player_logic::y1#0<=$1e0-$20) goto player_logic::@8 -- vwum1_le_vwuc1_then_la1 
    lda y1+1
    cmp #>$1e0-$20
    bne !+
    lda y1
    cmp #<$1e0-$20
  !:
    // [54] phi from player_logic::@7 to player_logic::@12 [phi:player_logic::@7->player_logic::@12]
    // player_logic::@12
    // player_logic::@8
    // unsigned char ap = flight.animate[p]
    // [55] player_logic::ap#0 = ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_ANIMATE)[player_logic::p#10] -- vbuaa=pbuc1_derefidx_vbum1 
    ldy p
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_ANIMATE,y
    // animate_player(ap, (signed int)mouse_x, (signed int)mouse_px)
    // [56] animate_player::a = player_logic::ap#0 -- vbum1=vbuaa 
    sta equinoxe_animate.animate_player.a
    // [57] animate_player::x = (int)player_logic::mouse_x -- vwsm1=vwsm2 
    lda mouse_x
    sta equinoxe_animate.animate_player.x
    lda mouse_x+1
    sta equinoxe_animate.animate_player.x+1
    // [58] animate_player::px = (int)player_logic::mouse_px -- vwsm1=vwsm2 
    lda mouse_px
    sta equinoxe_animate.animate_player.px
    lda mouse_px+1
    sta equinoxe_animate.animate_player.px+1
    // [59] callexecute animate_player  -- call_var_near 
    jsr equinoxe_animate.animate_player
    // unsigned char an = flight.animate[n]
    // [60] player_logic::an#0 = ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_ANIMATE)[player_logic::n#0] -- vbuaa=pbuc1_derefidx_vbum1 
    ldy n
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_ANIMATE,y
    // animate_logic(an)
    // [61] animate_logic::a = player_logic::an#0 -- vbum1=vbuaa 
    sta equinoxe_animate.animate_logic.a
    // [62] callexecute animate_logic  -- call_var_near 
    jsr equinoxe_animate.animate_logic
    // collision_insert(p)
    // [63] collision_insert::f = player_logic::p#10 -- vbum1=vbum2 
    lda p
    sta equinoxe_collision.collision_insert.f
    // [64] callexecute collision_insert  -- call_var_near 
    jsr equinoxe_collision.collision_insert
    jmp __b3
    // player_logic::@9
  __b9:
    // unsigned int x = flight.xi[p]
    // [65] player_logic::$35 = player_logic::p#10 << 1 -- vbuxx=vbum1_rol_1 
    lda p
    asl
    tax
    // [66] player_logic::x#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[player_logic::$35] -- vwum1=pwuc1_derefidx_vbuxx 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,x
    sta x
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,x
    sta x+1
    // unsigned int y = flight.yi[p]
    // [67] player_logic::y#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[player_logic::$35] -- vwum1=pwuc1_derefidx_vbuxx 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,x
    sta y
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,x
    sta y+1
    // if (flight.firegun[p])
    // [68] if(0==((char *)&flight+OFFSET_STRUCT_FLIGHT_T_FIREGUN)[player_logic::p#10]) goto player_logic::@6 -- 0_eq_pbuc1_derefidx_vbum1_then_la1 
    ldy p
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_FIREGUN,y
    cmp #0
    beq __b6
    // player_logic::@10
    // x += (signed char)16
    // [69] player_logic::x#1 = player_logic::x#0 + $10 -- vwum1=vwum1_plus_vbsc1 
    lda #$10
    clc
    sta.z $ff
    adc x
    sta x
    lda.z $ff
    ora #$7f
    bmi !+
    lda #0
  !:
    adc x+1
    sta x+1
    // [70] phi from player_logic::@10 player_logic::@9 to player_logic::@6 [phi:player_logic::@10/player_logic::@9->player_logic::@6]
    // [70] phi player_logic::x#2 = player_logic::x#1 [phi:player_logic::@10/player_logic::@9->player_logic::@6#0] -- register_copy 
    // player_logic::@6
  __b6:
    // flight.firegun[p] ^ 1
    // [71] player_logic::$13 = ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_FIREGUN)[player_logic::p#10] ^ 1 -- vbuaa=pbuc1_derefidx_vbum1_bxor_vbuc2 

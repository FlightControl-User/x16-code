    // __conio.color & 0x0F | color << 4
    // [182] bgcolor::$2 = bgcolor::$0 | BLUE<<4 -- vbuaa=vbuaa_bor_vbuc1 
    ora #BLUE<<4
    // __conio.color = __conio.color & 0x0F | color << 4
    // [183] *((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR) = bgcolor::$2 -- _deref_pbuc1=vbuaa 
    sta __conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR

    ldy p
    eor equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_FIREGUN,y
    // flight.firegun[p] = flight.firegun[p] ^ 1
    // [72] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_FIREGUN)[player_logic::p#10] = player_logic::$13 -- pbuc1_derefidx_vbum1=vbuaa 
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_FIREGUN,y
    // flight.reload[p] = 8
    // [73] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_RELOAD)[player_logic::p#10] = 8 -- pbuc1_derefidx_vbum1=vbuc2 
    lda #8

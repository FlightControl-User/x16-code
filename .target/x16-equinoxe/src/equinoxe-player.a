    lda x+1
    sta equinoxe_stage_flight.stage_bullet_add.sx+1
    // [75] stage_bullet_add::sy = player_logic::y#0 -- vwum1=vwum2 
    lda y
    sta equinoxe_stage_flight.stage_bullet_add.sy
    lda y+1
    sta equinoxe_stage_flight.stage_bullet_add.sy+1
    // [76] stage_bullet_add::tx = player_logic::x#2 -- vwum1=vwum2 

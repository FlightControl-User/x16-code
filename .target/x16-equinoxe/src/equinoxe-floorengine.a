    // [40] floor_layer_index_segments::$10 = (floor_segment_t *)floor_layer_index_segments::floor_layer#2 + OFFSET_STRUCT_FLOOR_LAYER_T_SEGMENTS -- pssz1=pssz2_plus_vbuc1 

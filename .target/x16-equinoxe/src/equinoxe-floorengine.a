  // floor_layer_index_segments
/**
 * @brief Iterate through the floor and build the floor index.
 * This to quickly be able to select a randomized segment for the specific range of segments with the same floor mask.
 * Each layer has its floor index with specific segments and composition of slabs.
 *
 * @param floor
 */
// void equinoxe_floorengine.floor_layer_index_segments(__zp($45) floor_t *floor)
floor_layer_index_segments: {
    // constants
    .const bank_push_set_bram1_bank = 5
    // variables
    // variables-zero-page
    .label floor = $45
    .label floor_layer_index_segments__10 = $26
    .label floor_layer_index_segments__14 = $3d
    .label floor_layer_index_segments__16 = $3b
    .label floor_layer_index_segments__17 = $2e
    .label floor_layer_index_segments__19 = $32
    .label floor_layer_index_segments__21 = $36
    .label floor_layer_index_segments__22 = $36
    .label floor_layer_index_segments__31 = $3d
    .label floor_layer_index_segments__33 = $3b
    .label floor_layer_index_segments__37 = $32
    .label floor_layer_index_segments__39 = $36
    .label floor_layer = $36
    // floor_layer_index_segments::bank_push_set_bram1
    // asm
    // asm { lda$00 pha  }
    lda.z 0
    pha
    // BRAM = bank
    // [31] BRAM = floor_layer_index_segments::bank_push_set_bram1_bank#0 -- vbuz1=vbuc1 
    lda #bank_push_set_bram1_bank
    sta.z BRAM

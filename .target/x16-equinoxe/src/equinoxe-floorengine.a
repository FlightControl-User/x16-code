    // [108] floor_draw_row::floor#1 = *((floor_t **)&stage+OFFSET_STRUCT_STAGE_T_FLOOR) -- pssz1=_deref_qssc1 
    lda equinoxe_stage_flight.stage+OFFSET_STRUCT_STAGE_T_FLOOR
    sta.z floor_draw_row.floor

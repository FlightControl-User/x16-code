    // [95] floor_scroll::row#0 = (char)floor_scroll::$3 -- vbuaa=_byte_vwum1 
    lda floor_scroll__3
    // row %= 32
    // [96] floor_scroll::row#1 = floor_scroll::row#0 & $20-1 -- vbum1=vbuaa_band_vbuc1 
    and #$20-1
    sta row

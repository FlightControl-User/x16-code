    asl
    asl
    asl
    asl
    // gotoxy(a / 32 * 16 + 2, a % 32)
    // [7] gotoxy::x#3 = animate_debug::$1 + 2 -- vbuxx=vbuaa_plus_2 
    tax
    inx
    inx
    // [8] gotoxy::y#3 = animate_debug::a & $20-1 -- vbuyy=vbum1_band_vbuc1 
    lda #$20-1
    and a
    tay
    // [9] call gotoxy
    // [230] phi from animate_debug to gotoxy [phi:animate_debug->gotoxy]
    // [230] phi gotoxy::y#10 = gotoxy::y#3 [phi:animate_debug->gotoxy#0] -- register_copy 
    // [230] phi gotoxy::x#4 = gotoxy::x#3 [phi:animate_debug->gotoxy#1] -- register_copy 
    jsr gotoxy
    // [10] phi from animate_debug to animate_debug::@1 [phi:animate_debug->animate_debug::@1]
    // animate_debug::@1
    // printf("s:%02x", animate.state[a])
    // [11] call printf_str
    // [245] phi from animate_debug::@1 to printf_str [phi:animate_debug::@1->printf_str]
    // [245] phi printf_str::putc#4 = &cputc [phi:animate_debug::@1->printf_str#0] -- pprz1=pprc1 
    lda #<cputc
    sta.z printf_str.putc
    lda #>cputc
    sta.z printf_str.putc+1
    // [245] phi printf_str::s#4 = animate_debug::s [phi:animate_debug::@1->printf_str#1] -- pbuz1=pbuc1 
    lda #<s
    sta.z printf_str.s
    lda #>s
    sta.z printf_str.s+1
    jsr printf_str
    // animate_debug::@2
    // printf("s:%02x", animate.state[a])
    // [12] printf_uchar::uvalue#0 = ((char *)&animate+OFFSET_STRUCT_ANIMATE_S_STATE)[animate_debug::a] -- vbuyy=pbuc1_derefidx_vbum1 
    ldx a
    ldy animate+OFFSET_STRUCT_ANIMATE_S_STATE,x
    // [13] call printf_uchar
    // [254] phi from animate_debug::@2 to printf_uchar [phi:animate_debug::@2->printf_uchar]
    jsr printf_uchar
    // animate_debug::@return
    // }
    // [14] return 
    rts

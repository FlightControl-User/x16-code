  // collision_insert
/**
 * @brief Add a new coordinate to the spacial grid.
 * This routine is very tricky. It requires to carefully determine which sectors
 * in the spacial grid are to be inserted in the has table.
 * And this is not obvious, sometimes also negative coordinates are given, like -64.
 * This has a risk of ending in an endless loop!
 * So the xmin and ymin are taken as char values, while the xmax and ymax values are taken as int values.
 * This to carefully compare the increment of ymin from 0x00F0 to 0x0100 and not to 0x0000!
 * Same for the xmin value. So the gx and gy values are also int to ensure that the addition is taken in two bytes.
 * But note that only the lower bytes of the int values are actually stored in the spacial grid coordinate system!
 *
 * @param ht
 * @param group
 * @param xmin
 * @param ymin
 * @param f
 */
// void equinoxe_collision.collision_insert(__mem() char f)
collision_insert: {
    // constants
    // variables
    // variables-zero-page
    // unsigned char xmin = flight.xi[f] >> 2
    // [91] collision_insert::$12 = collision_insert::f << 1 -- vbuaa=vbum1_rol_1 
    lda f
    asl
    // [92] collision_insert::xmin#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[collision_insert::$12] >> 2 -- vbum1=pwuc1_derefidx_vbuaa_ror_2 
    tay
    clc
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,y
    ror
    sta.z $ff
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,y
    ror
    sta.z $fe
    clc
    ror.z $ff
    ror
    sta xmin
    // unsigned char ymin = flight.yi[f] >> 2
    // [93] collision_insert::$13 = collision_insert::f << 1 -- vbuaa=vbum1_rol_1 
    lda f
    asl
    // [94] collision_insert::ymin#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[collision_insert::$13] >> 2 -- vbum1=pwuc1_derefidx_vbuaa_ror_2 
    tay
    clc
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,y
    ror
    sta.z $ff
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,y
    ror
    sta.z $fe
    clc
    ror.z $ff
    ror
    sta ymin
    // flight.cx[f] = xmin
    // [95] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_CX)[collision_insert::f] = collision_insert::xmin#0 -- pbuc1_derefidx_vbum1=vbum2 
    lda xmin
    ldy f
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_CX,y
    // flight.cy[f] = ymin
    // [96] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_CY)[collision_insert::f] = collision_insert::ymin#0 -- pbuc1_derefidx_vbum1=vbum2 
    lda ymin
    sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_CY,y
    // flight.collided[f] = 0
    // [97] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_COLLIDED)[collision_insert::f] = 0 -- pbuc1_derefidx_vbum1=0 
    ldx f
    stz equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_COLLIDED,x
    // xmin += 16
    // [98] collision_insert::xmin#1 = collision_insert::xmin#0 + $10 -- vbuxx=vbum1_plus_vbuc1 
    // The coordinates start at -63, so we add 16 to avoid negative numbers in the grid key.
    lda #$10
    clc
    adc xmin
    tax
    // ymin += 16
    // [99] collision_insert::ymin#1 = collision_insert::ymin#0 + $10 -- vbuyy=vbum1_plus_vbuc1 
    lda #$10
    clc
    adc ymin
    tay
    // (unsigned char)xmin + 8
    // [100] collision_insert::$2 = collision_insert::xmin#1 + 8 -- vbuaa=vbuxx_plus_vbuc1 
    txa
    clc
    adc #8
    // unsigned char xmax = ((unsigned char)xmin + 8) & 0b11110000
    // [101] collision_insert::xmax#0 = collision_insert::$2 & $f0 -- vbum1=vbuaa_band_vbuc1 
    and #$f0
    sta xmax
    // (unsigned char)ymin + 8
    // [102] collision_insert::$4 = collision_insert::ymin#1 + 8 -- vbuaa=vbuyy_plus_vbuc1 
    tya
    clc
    adc #8
    // unsigned char ymax = ((unsigned char)ymin + 8) & 0b11110000
    // [103] collision_insert::ymax#0 = collision_insert::$4 & $f0 -- vbum1=vbuaa_band_vbuc1 
    and #$f0
    sta ymax
    // xmin >>= 4
    // [104] collision_insert::gx#0 = collision_insert::xmin#1 >> 4 -- vbum1=vbuxx_ror_4 
    txa
    lsr
    lsr
    lsr
    lsr
    sta gx
    // xmax >>= 4
    // [105] collision_insert::xmax#1 = collision_insert::xmax#0 >> 4 -- vbum1=vbum1_ror_4 
    lda xmax
    lsr
    lsr
    lsr
    lsr
    sta xmax
    // ymin = ymin & 0b11110000
    // [106] collision_insert::ymin#2 = collision_insert::ymin#1 & $f0 -- vbum1=vbuyy_band_vbuc1 
    tya
    and #$f0
    sta ymin_1
    // [107] phi from collision_insert collision_insert::@5 to collision_insert::@1 [phi:collision_insert/collision_insert::@5->collision_insert::@1]
    // [107] phi collision_insert::gx#2 = collision_insert::gx#0 [phi:collision_insert/collision_insert::@5->collision_insert::@1#0] -- register_copy 
    // collision_insert::@1
  __b1:
    // for (unsigned char gx = xmin; gx <= xmax; gx += 1)
    // [108] if(collision_insert::gx#2<=collision_insert::xmax#1) goto collision_insert::@2 -- vbum1_le_vbum2_then_la1 
    lda xmax

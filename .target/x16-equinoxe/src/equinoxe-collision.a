    // [113] collision_insert::gx#1 = collision_insert::gx#2 + 1 -- vbum1=vbum1_plus_1 
    inc gx
    bra __b1
    // collision_insert::@4
  __b4:
    // ht_key_t ht_key = collision_key((unsigned char)gx, (unsigned char)gy)
    // [114] collision_key::gx#0 = collision_insert::gx#2 -- vbuaa=vbum1 
    lda gx
    // [115] collision_key::gy#0 = collision_insert::gy#2 -- vbuxx=vbum1 
    ldx gy
    // [116] call collision_key
    // [134] phi from collision_insert::@4 to collision_key [phi:collision_insert::@4->collision_key]
    // [134] phi collision_key::gx#2 = collision_key::gx#0 [phi:collision_insert::@4->collision_key#0] -- register_copy 
    // [134] phi collision_key::gy#2 = collision_key::gy#0 [phi:collision_insert::@4->collision_key#1] -- register_copy 
    jsr collision_key
    // ht_key_t ht_key = collision_key((unsigned char)gx, (unsigned char)gy)
    // [117] collision_key::return#2 = collision_key::return#0
    // collision_insert::@6
    // [118] collision_insert::ht_key#0 = collision_key::return#2
    // ht_insert(&collision_hash, ht_key, f)
    // [119] ht_insert::key#0 = collision_insert::ht_key#0 -- vbuyy=vbuaa 
    tay
    // [120] ht_insert::data#0 = collision_insert::f -- vbum1=vbum2 
    lda f
    sta ht_insert.data
    // [121] call ht_insert
    // [170] phi from collision_insert::@6 to ht_insert [phi:collision_insert::@6->ht_insert]
    jsr ht_insert
    // collision_insert::@7
    // gy + gx
    // [122] collision_insert::$11 = collision_insert::gy#2 + collision_insert::gx#2 -- vbuaa=vbum1_plus_vbum2 
    lda gy
    clc

    ldy #SIZEOF_STRUCT_COLLISION_DECISION_T
    lda #0
  !:
    dey
    sta collision_outer,y
    bne !-
    // collision_detect::ht_get_data1
    // return ht_list.data[ht_index];
    // [29] collision_detect::ht_get_data1_return#0 = ((char *)&ht_list)[collision_detect::ht_index_outer#10] -- vbuxx=pbuc1_derefidx_vbum1 
    ldy ht_index_outer

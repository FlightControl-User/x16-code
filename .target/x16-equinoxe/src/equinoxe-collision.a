    // return collision_quadrant.cell[gx + gy];
    // [12] collision_detect::collision_count1_return#0 = ((char *)&collision_quadrant)[collision_detect::collision_count1_$0] -- vbuaa=pbuc1_derefidx_vbuaa 
    tay
    lda collision_quadrant,y
    // collision_detect::@36
    // if (collision_count(gx, gy))
    // [13] if(0==collision_detect::collision_count1_return#0) goto collision_detect::@4 -- 0_eq_vbuaa_then_la1 
    cmp #0
    beq __b4
    // collision_detect::@35
    // ht_key_t ht_key_outer = collision_key(gx, gy)
    // [14] collision_key::gx#1 = collision_detect::gx#10 -- vbuaa=vbum1 
    lda gx
    // [15] collision_key::gy#1 = collision_detect::gy#2 -- vbuxx=vbum1 
    ldx gy
    // [16] call collision_key
    // [134] phi from collision_detect::@35 to collision_key [phi:collision_detect::@35->collision_key]
    // [134] phi collision_key::gx#2 = collision_key::gx#1 [phi:collision_detect::@35->collision_key#0] -- register_copy 
    // [134] phi collision_key::gy#2 = collision_key::gy#1 [phi:collision_detect::@35->collision_key#1] -- register_copy 
    jsr collision_key
    // ht_key_t ht_key_outer = collision_key(gx, gy)
    // [17] collision_key::return#3 = collision_key::return#0
    // collision_detect::@40
    // [18] collision_detect::ht_key_outer#0 = collision_key::return#3
    // ht_index_t ht_index_outer = ht_get(&collision_hash, ht_key_outer)
    // [19] ht_get::key#0 = collision_detect::ht_key_outer#0 -- vbuxx=vbuaa 
    tax
    // [20] call ht_get
    // [137] phi from collision_detect::@40 to ht_get [phi:collision_detect::@40->ht_get]
    jsr ht_get
    // ht_index_t ht_index_outer = ht_get(&collision_hash, ht_key_outer)
    // [21] ht_get::return#3 = ht_get::return#2 -- vbuaa=vbuxx 
    txa
    // collision_detect::@41
    // [22] collision_detect::ht_index_outer#0 = ht_get::return#3 -- vbum1=vbuaa 
    sta ht_index_outer
    // [23] phi from collision_detect::@41 collision_detect::ht_get_next2 to collision_detect::@5 [phi:collision_detect::@41/collision_detect::ht_get_next2->collision_detect::@5]
    // [23] phi collision_detect::ht_index_outer#10 = collision_detect::ht_index_outer#0 [phi:collision_detect::@41/collision_detect::ht_get_next2->collision_detect::@5#0] -- register_copy 
    // collision_detect::@5
  __b5:
    // while (ht_index_outer)
    // [24] if(0!=collision_detect::ht_index_outer#10) goto collision_detect::ht_get_next1 -- 0_neq_vbum1_then_la1 
    lda ht_index_outer
    bne ht_get_next1
    // collision_detect::@4
  __b4:
    // gx += (64 >> (2 + 4))
    // [25] collision_detect::gx#1 = collision_detect::gx#10 + $40>>2+4 -- vbum1=vbum1_plus_vbuc1 
    lda #$40>>2+4
    clc
    adc gx
    sta gx
    // [8] phi from collision_detect::@4 to collision_detect::@2 [phi:collision_detect::@4->collision_detect::@2]
    // [8] phi collision_detect::gx#10 = collision_detect::gx#1 [phi:collision_detect::@4->collision_detect::@2#0] -- register_copy 
    bra __b2
    // collision_detect::ht_get_next1
  ht_get_next1:
    // return ht_list.next[ht_index];
    // [26] collision_detect::ht_index_inner#0 = ((char *)&ht_list+OFFSET_STRUCT_HT_LIST_S_NEXT)[collision_detect::ht_index_outer#10] -- vbum1=pbuc1_derefidx_vbum2 

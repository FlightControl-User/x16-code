    // [111] phi from collision_insert::@2 collision_insert::@7 to collision_insert::@3 [phi:collision_insert::@2/collision_insert::@7->collision_insert::@3]
    // [111] phi collision_insert::gy#2 = collision_insert::gy#6 [phi:collision_insert::@2/collision_insert::@7->collision_insert::@3#0] -- register_copy 

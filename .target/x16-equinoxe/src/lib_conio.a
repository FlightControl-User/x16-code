    lda soffset_vram+1
    // *VERA_ADDRX_M = BYTE1(soffset_vram)
    // [662] *VERA_ADDRX_M = memcpy8_vram_vram::$1 -- _deref_pbuc1=vbuaa 
    sta VERA_ADDRX_M

    // [332] screensize::vscale#0 = *VERA_DC_VSCALE >> 7 -- vbuaa=_deref_pbuc1_ror_7 
    lda VERA_DC_VSCALE
    rol
    rol
    and #1
    // 30 << vscale
    // [333] screensize::$4 = $1e << screensize::vscale#0 -- vbuaa=vbuc1_rol_vbuaa 
    tay
    lda #$1e
    cpy #0
    beq !e+
  !:
    asl
    dey
    bne !-
  !e:
    // (30 << vscale)-1
    // [334] screensize::$5 = screensize::$4 - 1 -- vbuaa=vbuaa_minus_1 
    sec
    sbc #1
    // *y = (30 << vscale)-1
    // [335] *screensize::y#0 = screensize::$5 -- _deref_pbuz1=vbuaa 
    ldy #0
    sta (y_1),y
    // screensize::@return
    // }
    // [336] return 
    rts
}

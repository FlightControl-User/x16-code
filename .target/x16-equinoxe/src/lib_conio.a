    // [330] screensize::$2 = screensize::$1 - 1 -- vbuaa=vbuaa_minus_1 
    sec
    sbc #1
    // *x = (40 << hscale)-1
    // [331] *screensize::x#0 = screensize::$2 -- _deref_pbuz1=vbuaa 
    ldy #0
    sta (x_1),y

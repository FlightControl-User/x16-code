  // code segment
.segment CodeEngineFlight
  // sprite_image_cache_vram
// __mem() unsigned int equinoxe_flight_cache.sprite_image_cache_vram(__mem() char sprite_cache_index, __mem() char fe_sprite_image_index)
sprite_image_cache_vram: {
    // constants
    .const bank_push_set_bram1_bank = 4
    // variables
    // variables-zero-page
    .label sprite_ptr = $26
    .label sprite_image_cache_vram__40 = $24
    // unsigned int image_index = sprite_cache.offset[sprite_cache_index] + fe_sprite_image_index
    // [32] sprite_image_cache_vram::$36 = sprite_image_cache_vram::sprite_cache_index << 1 -- vbuaa=vbum1_rol_1 
    lda sprite_cache_index
    asl
    // [33] sprite_image_cache_vram::image_index#0 = ((unsigned int *)&sprite_cache+OFFSET_STRUCT_FE_SPRITE_CACHE_T_OFFSET)[sprite_image_cache_vram::$36] + sprite_image_cache_vram::fe_sprite_image_index -- vwum1=pwuc1_derefidx_vbuaa_plus_vbum2 
    // check if the image in vram is in use where the fe_sprite_vram_image_index is pointing to.
    // if this vram_image_used is false, that means that the image in vram is not in use anymore (not displayed or destroyed).
    tay
    lda fe_sprite_image_index
    clc
    adc sprite_cache+OFFSET_STRUCT_FE_SPRITE_CACHE_T_OFFSET,y
    sta image_index
    lda sprite_cache+OFFSET_STRUCT_FE_SPRITE_CACHE_T_OFFSET+1,y
    adc #0
    sta image_index+1
    // lru_cache_index_t vram_index = lru_cache_index(image_index)
    // [34] lru_cache_index::key = sprite_image_cache_vram::image_index#0 -- vwum1=vwum2 
    // We check if there is a cache hit?
    lda image_index
    sta lib_lru_cache.lru_cache_index.key
    lda image_index+1
    sta lib_lru_cache.lru_cache_index.key+1
    // [35] callexecute lru_cache_index  -- call_var_near 
    jsr lib_lru_cache.lru_cache_index
    // [36] sprite_image_cache_vram::vram_index#0 = lru_cache_index::return -- vbuaa=vbum1 
    lda lib_lru_cache.lru_cache_index.return
    // if (vram_index != 0xFF)
    // [37] if(sprite_image_cache_vram::vram_index#0!=$ff) goto sprite_image_cache_vram::@1 -- vbuaa_neq_vbuc1_then_la1 
    cmp #$ff
    beq !__b1+
    jmp __b1
  !__b1:
    // sprite_image_cache_vram::vera_display_set_border_color1
    // *VERA_CTRL &= 0b10000001
    // [38] *VERA_CTRL = *VERA_CTRL & $81 -- _deref_pbuc1=_deref_pbuc1_band_vbuc2 
    lda #$81
    and VERA_CTRL
    sta VERA_CTRL
    // *VERA_DC_BORDER = color
    // [39] *VERA_DC_BORDER = RED -- _deref_pbuc1=vbuc2 
    lda #RED
    sta VERA_DC_BORDER
    // sprite_image_cache_vram::@8
    // vera_heap_size_int_t vram_size_required = sprite_cache.size[sprite_cache_index]
    // [40] sprite_image_cache_vram::$37 = sprite_image_cache_vram::sprite_cache_index << 1 -- vbuaa=vbum1_rol_1 
    lda sprite_cache_index
    asl
    // [41] sprite_image_cache_vram::vram_size_required#0 = ((unsigned int *)&sprite_cache+OFFSET_STRUCT_FE_SPRITE_CACHE_T_SIZE)[sprite_image_cache_vram::$37] -- vwum1=pwuc1_derefidx_vbuaa 
    // The idea of this section is to free up lru_cache and/or vram memory until there is sufficient space available.
    // The size requested contains the required size to be allocated on vram.
    tay
    lda sprite_cache+OFFSET_STRUCT_FE_SPRITE_CACHE_T_SIZE,y
    sta vram_size_required
    lda sprite_cache+OFFSET_STRUCT_FE_SPRITE_CACHE_T_SIZE+1,y
    sta vram_size_required+1
    // bool vram_has_free = vera_heap_has_free(VERA_HEAP_SEGMENT_SPRITES, vram_size_required)
    // [42] vera_heap_has_free::s = 1 -- vbum1=vbuc1 
    // We check if the vram heap has sufficient memory available for the size requested.
    // We also check if the lru cache has sufficient elements left to contain the new sprite image.
    lda #1
    sta lib_veraheap.vera_heap_has_free.s
    // [43] vera_heap_has_free::size_requested = sprite_image_cache_vram::vram_size_required#0 -- vwum1=vwum2 
    lda vram_size_required
    sta lib_veraheap.vera_heap_has_free.size_requested
    lda vram_size_required+1
    sta lib_veraheap.vera_heap_has_free.size_requested+1
    // [44] callexecute vera_heap_has_free  -- call_var_near 
    jsr lib_veraheap.vera_heap_has_free
    // [45] sprite_image_cache_vram::vram_has_free#0 = vera_heap_has_free::return -- vbom1=vbom2 
    lda lib_veraheap.vera_heap_has_free.return
    sta vram_has_free

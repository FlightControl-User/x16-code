    lda #0
    sta.z BRAM
    // __export volatile __address(0x01) unsigned char BROM = 4
    // [2] BROM = 4 -- vbuz1=vbuc1 
    lda #4
    sta.z BROM
    // unsigned char flight_sprite_offset_pool = 1
    // [3] flight_sprite_offset_pool = 1 -- vbum1=vbuc1 
    lda #1
    sta flight_sprite_offset_pool
    // __equinoxe_flight_cache_start::@return
    // [4] return 
    rts
}

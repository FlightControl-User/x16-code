  // flight_sprite_next_offset
// __mem() unsigned int equinoxe_flight_cache.flight_sprite_next_offset()
flight_sprite_next_offset: {
    // constants
    // variables
    // variables-zero-page
    // flight_sprite_next_offset::@1
  __b1:
    // !flight_sprite_offset_pool || flight_sprite_offsets[flight_sprite_offset_pool]
    // [13] flight_sprite_next_offset::$5 = flight_sprite_offset_pool << 1 -- vbuxx=vbum1_rol_1 
    lda flight_sprite_offset_pool
    asl
    tax
    // while (!flight_sprite_offset_pool || flight_sprite_offsets[flight_sprite_offset_pool])
    // [14] if(0==flight_sprite_offset_pool) goto flight_sprite_next_offset::@2 -- 0_eq_vbum1_then_la1 
    lda flight_sprite_offset_pool
    beq __b2
    // flight_sprite_next_offset::@5
    // [15] if(0!=flight_sprite_offsets[flight_sprite_next_offset::$5]) goto flight_sprite_next_offset::@2 -- 0_neq_pwuc1_derefidx_vbuxx_then_la1 
    lda flight_sprite_offsets+1,x
    ora flight_sprite_offsets,x
    bne __b2
    // flight_sprite_next_offset::@3
    // vera_sprite_offset sprite_offset = vera_sprite_get_offset(flight_sprite_offset_pool)
    // [16] flight_sprite_next_offset::vera_sprite_get_offset1_sprite_id#0 = flight_sprite_offset_pool -- vbuaa=vbum1 
    lda flight_sprite_offset_pool
    // flight_sprite_next_offset::vera_sprite_get_offset1
    // ((unsigned int)sprite_id) << 3
    // [17] flight_sprite_next_offset::vera_sprite_get_offset1_$2 = (unsigned int)flight_sprite_next_offset::vera_sprite_get_offset1_sprite_id#0 -- vwum1=_word_vbuaa 
    sta vera_sprite_get_offset1_flight_sprite_next_offset__2
    lda #0
    sta vera_sprite_get_offset1_flight_sprite_next_offset__2+1
    // [18] flight_sprite_next_offset::vera_sprite_get_offset1_$0 = flight_sprite_next_offset::vera_sprite_get_offset1_$2 << 3 -- vwum1=vwum1_rol_3 
    asl vera_sprite_get_offset1_flight_sprite_next_offset__0
    rol vera_sprite_get_offset1_flight_sprite_next_offset__0+1
    asl vera_sprite_get_offset1_flight_sprite_next_offset__0
    rol vera_sprite_get_offset1_flight_sprite_next_offset__0+1
    asl vera_sprite_get_offset1_flight_sprite_next_offset__0
    rol vera_sprite_get_offset1_flight_sprite_next_offset__0+1
    // WORD0(VERA_SPRITE_ATTR)+(((unsigned int)sprite_id) << 3)
    // [19] flight_sprite_next_offset::vera_sprite_get_offset1_$1 = word0 VERA_SPRITE_ATTR + flight_sprite_next_offset::vera_sprite_get_offset1_$0 -- vwum1=vwuc1_plus_vwum1 
    lda vera_sprite_get_offset1_flight_sprite_next_offset__1
    clc
    adc #<VERA_SPRITE_ATTR&$ffff
    sta vera_sprite_get_offset1_flight_sprite_next_offset__1
    lda vera_sprite_get_offset1_flight_sprite_next_offset__1+1
    adc #>VERA_SPRITE_ATTR&$ffff
    sta vera_sprite_get_offset1_flight_sprite_next_offset__1+1
    // return WORD0(VERA_SPRITE_ATTR)+(((unsigned int)sprite_id) << 3);
    // [20] flight_sprite_next_offset::vera_sprite_get_offset1_return#0 = flight_sprite_next_offset::vera_sprite_get_offset1_$1
    // flight_sprite_next_offset::vera_sprite_get_offset1_@return
    // }
    // [21] flight_sprite_next_offset::vera_sprite_get_offset1_return#1 = flight_sprite_next_offset::vera_sprite_get_offset1_return#0
    // flight_sprite_next_offset::@4
    // vera_sprite_offset sprite_offset = vera_sprite_get_offset(flight_sprite_offset_pool)
    // [22] flight_sprite_next_offset::sprite_offset#0 = flight_sprite_next_offset::vera_sprite_get_offset1_return#1 -- vwum1=vwum2 
    lda vera_sprite_get_offset1_return
    sta sprite_offset
    lda vera_sprite_get_offset1_return+1
    sta sprite_offset+1
    // flight_sprite_offsets[flight_sprite_offset_pool] = sprite_offset
    // [23] flight_sprite_next_offset::$6 = flight_sprite_offset_pool << 1 -- vbuaa=vbum1_rol_1 
    lda flight_sprite_offset_pool
    asl
    // [24] flight_sprite_offsets[flight_sprite_next_offset::$6] = flight_sprite_next_offset::sprite_offset#0 -- pwuc1_derefidx_vbuaa=vwum1 
    tay
    lda sprite_offset
    sta flight_sprite_offsets,y
    lda sprite_offset+1
    sta flight_sprite_offsets+1,y
    // return sprite_offset;
    // [25] flight_sprite_next_offset::return = flight_sprite_next_offset::sprite_offset#0
    // flight_sprite_next_offset::@return
    // }
    // [26] return 
    rts
    // flight_sprite_next_offset::@2
  __b2:
    // flight_sprite_offset_pool + 1
    // [27] flight_sprite_next_offset::$3 = flight_sprite_offset_pool + 1 -- vbuaa=vbum1_plus_1 
    lda flight_sprite_offset_pool
    inc
    // (flight_sprite_offset_pool + 1) % 128
    // [28] flight_sprite_next_offset::$4 = flight_sprite_next_offset::$3 & $80-1 -- vbuaa=vbuaa_band_vbuc1 
    and #$80-1
    // flight_sprite_offset_pool = (flight_sprite_offset_pool + 1) % 128
    // [29] flight_sprite_offset_pool = flight_sprite_next_offset::$4 -- vbum1=vbuaa 
    sta flight_sprite_offset_pool
    jmp __b1

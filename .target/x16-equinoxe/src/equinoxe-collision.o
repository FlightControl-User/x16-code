        "collision_insert": {
            "zp": {
                "zp_fields": {
                }
            },
            "exported": true,
            "asm_begin": "  // code segment\n.segment Code\n  // collision_insert\n/**\r\n * @brief Add a new coordinate to the spacial grid.\r\n * This routine is very tricky. It requires to carefully determine which sectors\r\n * in the spacial grid are to be inserted in the has table.\r\n * And this is not obvious, sometimes also negative coordinates are given, like -64.\r\n * This has a risk of ending in an endless loop!\r\n * So the xmin and ymin are taken as char values, while the xmax and ymax values are taken as int values.\r\n * This to carefully compare the increment of ymin from 0x00F0 to 0x0100 and not to 0x0000!\r\n * Same for the xmin value. So the gx and gy values are also int to ensure that the addition is taken in two bytes.\r\n * But note that only the lower bytes of the int values are actually stored in the spacial grid coordinate system!\r\n *\r\n * @param ht\r\n * @param group\r\n * @param xmin\r\n * @param ymin\r\n * @param f\r\n */\n// void equinoxe_collision.collision_insert(__mem() char f)\ncollision_insert: {\n",
            "asm_constants": "  // constants\n",
            "asm_variables": "  // variables\n",
            "asm_end": "  // [91] collision_insert::$12 = collision_insert::f << 1 -- vbuaa=vbum1_rol_1 \n  lda f\n  asl\n  // [92] collision_insert::xmin#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[collision_insert::$12] >> 2 -- vbum1=pwuc1_derefidx_vbuaa_ror_2 \n  tay\n  clc\n  lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,y\n  ror\n  sta.z $ff\n  lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,y\n  ror\n  sta.z $fe\n  clc\n  ror.z $ff\n  ror\n  sta xmin\n  // [93] collision_insert::$13 = collision_insert::f << 1 -- vbuaa=vbum1_rol_1 \n  lda f\n  asl\n  // [94] collision_insert::ymin#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[collision_insert::$13] >> 2 -- vbum1=pwuc1_derefidx_vbuaa_ror_2 \n  tay\n  clc\n  lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,y\n  ror\n  sta.z $ff\n  lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,y\n  ror\n  sta.z $fe\n  clc\n  ror.z $ff\n  ror\n  sta ymin\n  // [95] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_CX)[collision_insert::f] = collision_insert::xmin#0 -- pbuc1_derefidx_vbum1=vbum2 \n  lda xmin\n  ldy f\n  sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_CX,y\n  // [96] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_CY)[collision_insert::f] = collision_insert::ymin#0 -- pbuc1_derefidx_vbum1=vbum2 \n  lda ymin\n  sta equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_CY,y\n  // [97] ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_COLLIDED)[collision_insert::f] = 0 -- pbuc1_derefidx_vbum1=0 \n  ldx f\n  stz equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_COLLIDED,x\n  // [98] collision_insert::xmin#1 = collision_insert::xmin#0 + $10 -- vbuxx=vbum1_plus_vbuc1 \n  // The coordinates start at -63, so we add 16 to avoid negative numbers in the grid key.\n  lda #$10\n  clc\n  adc xmin\n  tax\n  // [99] collision_insert::ymin#1 = collision_insert::ymin#0 + $10 -- vbuyy=vbum1_plus_vbuc1 \n  lda #$10\n  clc\n  adc ymin\n  tay\n  // [100] collision_insert::$2 = collision_insert::xmin#1 + 8 -- vbuaa=vbuxx_plus_vbuc1 \n  txa\n  clc\n  adc #8\n  // [101] collision_insert::xmax#0 = collision_insert::$2 & $f0 -- vbum1=vbuaa_band_vbuc1 \n  and #$f0\n  sta xmax\n  // [102] collision_insert::$4 = collision_insert::ymin#1 + 8 -- vbuaa=vbuyy_plus_vbuc1 \n  tya\n  clc\n  adc #8\n  // [103] collision_insert::ymax#0 = collision_insert::$4 & $f0 -- vbum1=vbuaa_band_vbuc1 \n  and #$f0\n  sta ymax\n  // [104] collision_insert::gx#0 = collision_insert::xmin#1 >> 4 -- vbum1=vbuxx_ror_4 \n  txa\n  lsr\n  lsr\n  lsr\n  lsr\n  sta gx\n  // [105] collision_insert::xmax#1 = collision_insert::xmax#0 >> 4 -- vbum1=vbum1_ror_4 \n  lda xmax\n  lsr\n  lsr\n  lsr\n  lsr\n  sta xmax\n  // [106] collision_insert::ymin#2 = collision_insert::ymin#1 & $f0 -- vbum1=vbuyy_band_vbuc1 \n  tya\n  and #$f0\n  sta ymin_1\n  // [107] phi from collision_insert collision_insert::@5 to collision_insert::@1 [phi:collision_insert/collision_insert::@5->collision_insert::@1]\n  // [107] phi collision_insert::gx#2 = collision_insert::gx#0 [phi:collision_insert/collision_insert::@5->collision_insert::@1#0] -- register_copy \n  // collision_insert::@1\n__b1:\n  // [108] if(collision_insert::gx#2<=collision_insert::xmax#1) goto collision_insert::@2 -- vbum1_le_vbum2_then_la1 \n  lda xmax\n  cmp gx\n  bcs __b2\n  // collision_insert::@return\n  // [109] return \n  rts\n  // collision_insert::@2\n__b2:\n  // [110] collision_insert::gy#6 = collision_insert::ymin#2 -- vbum1=vbum2 \n  lda ymin_1\n  sta gy\n  // [111] phi from collision_insert::@2 collision_insert::@7 to collision_insert::@3 [phi:collision_insert::@2/collision_insert::@7->collision_insert::@3]\n  // [111] phi collision_insert::gy#2 = collision_insert::gy#6 [phi:collision_insert::@2/collision_insert::@7->collision_insert::@3#0] -- register_copy \n  // collision_insert::@3\n__b3:\n  // [112] if(collision_insert::gy#2<=collision_insert::ymax#0) goto collision_insert::@4 -- vbum1_le_vbum2_then_la1 \n  lda ymax\n  cmp gy\n  bcs __b4\n  // collision_insert::@5\n  // [113] collision_insert::gx#1 = collision_insert::gx#2 + 1 -- vbum1=vbum1_plus_1 \n  inc gx\n  bra __b1\n  // collision_insert::@4\n__b4:\n  // [114] collision_key::gx#0 = collision_insert::gx#2 -- vbuaa=vbum1 \n  lda gx\n  // [115] collision_key::gy#0 = collision_insert::gy#2 -- vbuxx=vbum1 \n  ldx gy\n  // [116] call collision_key\n  // [134] phi from collision_insert::@4 to collision_key [phi:collision_insert::@4->collision_key]\n  // [134] phi collision_key::gx#2 = collision_key::gx#0 [phi:collision_insert::@4->collision_key#0] -- register_copy \n  // [134] phi collision_key::gy#2 = collision_key::gy#0 [phi:collision_insert::@4->collision_key#1] -- register_copy \n  jsr collision_key\n  // [117] collision_key::return#2 = collision_key::return#0\n  // collision_insert::@6\n  // [118] collision_insert::ht_key#0 = collision_key::return#2\n  // [119] ht_insert::key#0 = collision_insert::ht_key#0 -- vbuyy=vbuaa \n  tay\n  // [120] ht_insert::data#0 = collision_insert::f -- vbum1=vbum2 \n  lda f\n  sta ht_insert.data\n  // [121] call ht_insert\n  // [170] phi from collision_insert::@6 to ht_insert [phi:collision_insert::@6->ht_insert]\n  jsr ht_insert\n  // collision_insert::@7\n  // [122] collision_insert::$11 = collision_insert::gy#2 + collision_insert::gx#2 -- vbuaa=vbum1_plus_vbum2 \n  lda gy\n  clc\n  adc gx\n  // [123] ((char *)&collision_quadrant)[collision_insert::$11] = ((char *)&collision_quadrant)[collision_insert::$11] + 1 -- pbuc1_derefidx_vbuaa=pbuc1_derefidx_vbuaa_plus_1 \n  tay\n  lda collision_quadrant,y\n  inc\n  sta collision_quadrant,y\n  // [124] collision_insert::gy#1 = collision_insert::gy#2 + $10 -- vbum1=vbum1_plus_vbuc1 \n  lda #$10\n  clc\n  adc gy\n  sta gy\n  bra __b3\n.segment Data\n  f: .byte 0\n.segment Data\n  xmin: .byte 0\n.segment Data\n  ymin: .byte 0\n.segment Data\n  xmax: .byte 0\n.segment Data\n  ymax: .byte 0\n.segment Data\n  ymin_1: .byte 0\n.segment Data\n  gx: .byte 0\n.segment Data\n  gy: .byte 0\n}\n"
        },
        "collision_data": {
            "zp": {
                "zp_fields": {
                    "collision_decision": [
                        34,

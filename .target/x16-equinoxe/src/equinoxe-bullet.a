    lda #$f0
    and __conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR
    // __conio.color & 0xF0 | color
    // [148] textcolor::$1 = textcolor::$0 | WHITE -- vbuaa=vbuaa_bor_vbuc1 
    ora #WHITE
    // __conio.color = __conio.color & 0xF0 | color
    // [149] *((char *)&__conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR) = textcolor::$1 -- _deref_pbuc1=vbuaa 
    sta __conio+OFFSET_STRUCT___CX16_CONIO_S_COLOR
    // textcolor::@return
    // }
    // [150] return 
    rts
}

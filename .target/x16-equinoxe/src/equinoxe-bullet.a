.segment Code
  // rand
// Returns a pseudo-random number in the range of 0 to RAND_MAX (65535)
// Uses an xorshift pseudorandom number generator that hits all different values
// Information https://en.wikipedia.org/wiki/Xorshift
// Source http://www.retroprogramming.com/2017/07/xorshift-pseudorandom-numbers-in-z80.html
// __mem() unsigned int rand()
rand: {
    // constants
    // variables
    // variables-zero-page
    // rand_state << 7
    // [108] rand::$0 = rand_state << 7 -- vwum1=vwum2_rol_7 
    lda rand_state+1
    lsr
    lda rand_state
    ror
    sta rand__0+1
    lda #0
    ror
    sta rand__0
    // rand_state ^= rand_state << 7
    // [109] rand_state = rand_state ^ rand::$0 -- vwum1=vwum1_bxor_vwum2 
    lda rand_state
    eor rand__0
    sta rand_state
    lda rand_state+1
    eor rand__0+1
    sta rand_state+1
    // rand_state >> 9
    // [110] rand::$1 = rand_state >> 9 -- vwum1=vwum2_ror_9 
    lsr
    sta rand__1
    lda #0
    sta rand__1+1
    // rand_state ^= rand_state >> 9
    // [111] rand_state = rand_state ^ rand::$1 -- vwum1=vwum1_bxor_vwum2 
    lda rand_state
    eor rand__1
    sta rand_state
    lda rand_state+1
    eor rand__1+1
    sta rand_state+1
    // rand_state << 8
    // [112] rand::$2 = rand_state << 8 -- vwum1=vwum2_rol_8 
    lda rand_state
    sta rand__2+1
    lda #0
    sta rand__2
    // rand_state ^= rand_state << 8
    // [113] rand_state = rand_state ^ rand::$2 -- vwum1=vwum1_bxor_vwum2 
    lda rand_state
    eor rand__2
    sta rand_state
    lda rand_state+1
    eor rand__2+1
    sta rand_state+1
    // return rand_state;
    // [114] rand::return#0 = rand_state -- vwum1=vwum2 
    lda rand_state
    sta return
    lda rand_state+1
    sta return+1
    // rand::@return
    // }
    // [115] return 
    rts
  .segment Data
    rand__0: .word 0
  .segment Data
    rand__1: .word 0
  .segment Data
    rand__2: .word 0
  .segment Data
    return: .word 0
}
  // Exported Global Data
.segment Data
  // #pragma data_seg(Math)
math_sin:
.fillword 64, 128*sin(toRadians(i*360/64))

.segment Data
math_cos:
.fillword 64, 128*cos(toRadians(i*360/64))

.segment Data
  .align $100
logtab:
.fill $100, (log(i)/log(2))*32

.segment Data
  .align $100
atantab:
.for(var i=-256;i<0;i++) {
    .byte (atan(pow(2.0,(i/32.0)))*64/(PI*2))
	}
//    .fill $100, i

.segment Data
  .align $100
adjust_octant:
.byte %00001111		// x+,y+,|x|>|y|
	.byte %00000000		// x+,y+,|x|<|y|
	.byte %00110000		// x+,y-,|x|>|y|
	.byte %00111111		// x+,y-,|x|<|y|
	.byte %00010000		// x-,y+,|x|>|y|
	.byte %00011111		// x-,y+,|x|<|y|
	.byte %00101111		// x-,y-,|x|>|y|
	.byte %00100000		// x-,y-,|x|<|y|

.segment Data
  // The random state variable
  rand_state: .word 1
  // end-assembler

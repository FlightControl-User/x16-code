.segment Code
  // __equinoxe_bullet_start
// void equinoxe_bullet.__equinoxe_bullet_start()
__equinoxe_bullet_start: {
    // constants
    // variables
    // variables-zero-page
    // __equinoxe_bullet_start::__init1
    // __export volatile __address(0x00) unsigned char BRAM = 0
    // [1] BRAM = 0 -- vbuz1=0 
    stz.z BRAM
    // __export volatile __address(0x01) unsigned char BROM = 4
    // [2] BROM = 4 -- vbuz1=vbuc1 
    lda #4
    sta.z BROM
    // __equinoxe_bullet_start::@return
    // [3] return 
    rts
}
  // code segment
.segment CodeEngineBullets
  // bullet_logic
// void equinoxe_bullet.bullet_logic()
// __bank(cx16_ram, 7) 
bullet_logic: {
    // constants
    .label xf = equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XF
    .label yf = equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YF
    .label xi = equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI
    .label yi = equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI
    .label xd = equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XD
    .label yd = equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YD
    // variables
    // variables-zero-page
    // flight_index_t b = flight_root(FLIGHT_BULLET)
    // [18] flight_root::type = 3 -- vbum1=vbuc1 
    lda #3
    sta equinoxe_flightengine.flight_root.type
    // [19] callexecute flight_root  -- call_var_near 
    jsr equinoxe_flightengine.flight_root
    // [20] bullet_logic::b#0 = flight_root::return -- vbum1=vbum2 
    lda equinoxe_flightengine.flight_root.return
    sta b
    // [21] phi from bullet_logic bullet_logic::@3 to bullet_logic::@1 [phi:bullet_logic/bullet_logic::@3->bullet_logic::@1]
    // [21] phi bullet_logic::b#2 = bullet_logic::b#0 [phi:bullet_logic/bullet_logic::@3->bullet_logic::@1#0] -- register_copy 
    // bullet_logic::@1
  __b1:
    // while(b)
    // [22] if(0!=bullet_logic::b#2) goto bullet_logic::@2 -- 0_neq_vbum1_then_la1 
    lda b
    bne __b2
    // bullet_logic::@return
    // }
    // [23] return 
    rts
    // bullet_logic::@2
  __b2:
    // flight_index_t bn = flight_next(b)
    // [24] flight_next::i = bullet_logic::b#2 -- vbum1=vbum2 
    lda b
    sta equinoxe_flightengine.flight_next.i
    // [25] callexecute flight_next  -- call_var_near 
    jsr equinoxe_flightengine.flight_next
    // [26] bullet_logic::b#1 = flight_next::return -- vbum1=vbum2 
    lda equinoxe_flightengine.flight_next.return
    sta b_1
    // if(flight.type[b] == FLIGHT_BULLET && flight.used[b])
    // [27] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_TYPE)[bullet_logic::b#2]!=3) goto bullet_logic::@3 -- pbuc1_derefidx_vbum1_neq_vbuc2_then_la1 
    lda #3
    ldy b
    cmp equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_TYPE,y
    bne __b3
    // bullet_logic::@7
    // [28] if(0!=((char *)&flight+OFFSET_STRUCT_FLIGHT_T_USED)[bullet_logic::b#2]) goto bullet_logic::@5 -- 0_neq_pbuc1_derefidx_vbum1_then_la1 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_USED,y
    cmp #0
    bne __b5
    // bullet_logic::@3
  __b3:
    // [29] bullet_logic::b#8 = bullet_logic::b#1 -- vbum1=vbum2 
    lda b_1
    sta b
    bra __b1
    // bullet_logic::@5
  __b5:
    // kickasm
    // kickasm( uses bullet_logic::xf uses bullet_logic::yf uses bullet_logic::xi uses bullet_logic::yi uses bullet_logic::xd uses bullet_logic::yd) {{ lda b                 asl                 tay                 ldx b                 lda xf,x        // Load the fractional part of the coordinate.                 clc             // For addition, clear the carry.                 adc xd,y        // Add the low byte (=fractional part) of the delta.                 sta xf,x        // Store the low byte of the delta in the fractional part of the coordinate.                 lda xi,y        // Load the low byte of the integer part of the coordinate.                 adc xd+1,y      // Add the high byte (=integer part) of the delta.                 sta xi,y        // Store the result in the low byte of the integer part of the coordinate.                 lda xd+1,y      // Load back the high byte of the axis delta, it may be negative.                 ora #$7f        // We check the sign bit.                 bmi !+          // If it was minus, the result in A will be $FF.                 lda #0          // The result was not minus, so just add carry.                 !:                 adc xi+1,y      // Now do the signed final addition.                 sta xi+1,y      // And store the result, we're done.                  lda yf,x        // Load the fractional part of the coordinate.                 clc             // For addition, clear the carry.                 adc yd,y        // Add the low byte (=fractional part) of the delta.                 sta yf,x        // Store the low byte of the delta in the fractional part of the coordinate.                 lda yi,y        // Load the low byte of the integer part of the coordinate.                 adc yd+1,y      // Add the high byte (=integer part) of the delta.                 sta yi,y        // Store the result in the low byte of the integer part of the coordinate.                 lda yd+1,y      // Load back the high byte of the delta, it may be negative.                 ora #$7f        // We check the sign bit.                 bmi !+          // If it was minus, the result in A will be $FF.                 lda #0          // The result was not minus, so just add carry.                 !:                 adc yi+1,y      // Now do the signed final addition.                 sta yi+1,y      // And store the result, we're done.              }}
    lda b
                asl
                tay
                ldx b
                lda xf,x        // Load the fractional part of the coordinate.
                clc             // For addition, clear the carry.
                adc xd,y        // Add the low byte (=fractional part) of the delta.
                sta xf,x        // Store the low byte of the delta in the fractional part of the coordinate.
                lda xi,y        // Load the low byte of the integer part of the coordinate.
                adc xd+1,y      // Add the high byte (=integer part) of the delta.
                sta xi,y        // Store the result in the low byte of the integer part of the coordinate.
                lda xd+1,y      // Load back the high byte of the axis delta, it may be negative.
                ora #$7f        // We check the sign bit.
                bmi !+          // If it was minus, the result in A will be $FF.
                lda #0          // The result was not minus, so just add carry.
                !:
                adc xi+1,y      // Now do the signed final addition.
                sta xi+1,y      // And store the result, we're done.

                lda yf,x        // Load the fractional part of the coordinate.
                clc             // For addition, clear the carry.
                adc yd,y        // Add the low byte (=fractional part) of the delta.
                sta yf,x        // Store the low byte of the delta in the fractional part of the coordinate.
                lda yi,y        // Load the low byte of the integer part of the coordinate.
                adc yd+1,y      // Add the high byte (=integer part) of the delta.
                sta yi,y        // Store the result in the low byte of the integer part of the coordinate.
                lda yd+1,y      // Load back the high byte of the delta, it may be negative.
                ora #$7f        // We check the sign bit.
                bmi !+          // If it was minus, the result in A will be $FF.
                lda #0          // The result was not minus, so just add carry.
                !:
                adc yi+1,y      // Now do the signed final addition.
                sta yi+1,y      // And store the result, we're done.
            
    // unsigned int x = flight.xi[b]
    // [31] bullet_logic::$17 = bullet_logic::b#2 << 1 -- vbuxx=vbum1_rol_1 
    lda b
    asl
    tax
    // [32] bullet_logic::x#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_XI)[bullet_logic::$17] -- vwum1=pwuc1_derefidx_vbuxx 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI,x
    sta x
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_XI+1,x
    sta x+1
    // unsigned int y = flight.yi[b]
    // [33] bullet_logic::y#0 = ((unsigned int *)&flight+OFFSET_STRUCT_FLIGHT_T_YI)[bullet_logic::$17] -- vwum1=pwuc1_derefidx_vbuxx 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI,x
    sta y
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_YI+1,x
    sta y+1
    // if(x<640 && y<480 && x<0xFFFF-32 && y<0xFFFF-32)
    // [34] if(bullet_logic::x#0>=$280) goto bullet_logic::@6 -- vwum1_ge_vwuc1_then_la1 
    lda x+1
    cmp #>$280
    bcc !+
    bne __b6
    lda x
    cmp #<$280
    bcs __b6
  !:
    // bullet_logic::@10
    // [35] if(bullet_logic::y#0<$1e0) goto bullet_logic::@9 -- vwum1_lt_vwuc1_then_la1 
    lda y+1
    cmp #>$1e0
    bcc __b9
    bne !+
    lda y
    cmp #<$1e0
    bcc __b9
  !:
    // bullet_logic::@6
  __b6:
    // stage_bullet_remove(b)
    // [36] stage_bullet_remove::b = bullet_logic::b#2 -- vbum1=vbum2 
    lda b
    sta equinoxe_stage_flight.stage_bullet_remove.b
    // [37] callexecute stage_bullet_remove  -- call_var_far_cx16_ram 
    jsr $ff6e
    .byte <equinoxe_stage_flight.stage_bullet_remove
    .byte >equinoxe_stage_flight.stage_bullet_remove
    .byte 3
    jmp __b3
    // bullet_logic::@9
  __b9:
    // if(x<640 && y<480 && x<0xFFFF-32 && y<0xFFFF-32)
    // [38] if(bullet_logic::x#0>=$ffff-$20) goto bullet_logic::@6 -- vwum1_ge_vwuc1_then_la1 
    lda x+1
    cmp #>$ffff-$20
    bcc !+
    bne __b6
    lda x
    cmp #<$ffff-$20
    bcs __b6
  !:
    // bullet_logic::@8
    // [39] if(bullet_logic::y#0<$ffff-$20) goto bullet_logic::@4 -- vwum1_lt_vwuc1_then_la1 
    lda y+1
    cmp #>$ffff-$20
    bcc __b4
    bne !+
    lda y
    cmp #<$ffff-$20
    bcc __b4
  !:
    bra __b6
    // bullet_logic::@4
  __b4:
    // unsigned char volatile a = flight.animate[b]
    // [40] bullet_logic::a = ((char *)&flight+OFFSET_STRUCT_FLIGHT_T_ANIMATE)[bullet_logic::b#2] -- vbum1=pbuc1_derefidx_vbum2 
    ldy b
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_ANIMATE,y
    sta a
    // animate_logic(a)
    // [41] animate_logic::a = bullet_logic::a -- vbum1=vbum2 
    sta equinoxe_animate.animate_logic.a
    // [42] callexecute animate_logic  -- call_var_near 
    jsr equinoxe_animate.animate_logic
    // collision_insert(b)
    // [43] collision_insert::f = bullet_logic::b#2 -- vbum1=vbum2 
    lda b
    sta equinoxe_collision.collision_insert.f
    // [44] callexecute collision_insert  -- call_var_near 
    jsr equinoxe_collision.collision_insert
    jmp __b3
  .segment DataEngineBullets
    a: .byte 0
  .segment DataEngineBullets
    b: .byte 0
  .segment DataEngineBullets
    b_1: .byte 0
  .segment DataEngineBullets
    x: .word 0
  .segment DataEngineBullets
    y: .word 0
}
  // code segment
.segment CodeEngineBullets
  // bullet_add
// __mem() char equinoxe_bullet.bullet_add(__mem() unsigned int sx, __mem() unsigned int sy, __mem() unsigned int tx, __mem() unsigned int ty, __mem() char speed, __mem() char side, __mem() char sprite_bullet)
// __bank(cx16_ram, 7) 
bullet_add: {
    // constants
    // variables
    // variables-zero-page
    .label math_vecy1_return = $22
    // flight_index_t b = flight_add(FLIGHT_BULLET, side, sprite_bullet)
    // [45] flight_add::type = 3 -- vbum1=vbuc1 
    lda #3
    sta equinoxe_flightengine.flight_add.type
    // [46] flight_add::side = bullet_add::side -- vbum1=vbum2 
    lda side
    sta equinoxe_flightengine.flight_add.side
    // [47] flight_add::sprite = bullet_add::sprite_bullet -- vbum1=vbum2 
    lda sprite_bullet
    sta equinoxe_flightengine.flight_add.sprite
    // [48] callexecute flight_add  -- call_var_near 
    jsr equinoxe_flightengine.flight_add
    // [49] bullet_add::b#0 = flight_add::return -- vbum1=vbum2 
    lda equinoxe_flightengine.flight_add.return
    sta b
    // sx >> 2
    // [50] bullet_add::$1 = bullet_add::sx >> 2 -- vwum1=vwum2_ror_2 
    lda sx+1
    lsr
    sta bullet_add__1+1
    lda sx
    ror
    sta bullet_add__1
    lsr bullet_add__1+1
    ror bullet_add__1
    // unsigned char asx = BYTE0(sx >> 2)
    // [51] bullet_add::asx#0 = byte0  bullet_add::$1 -- vbuyy=_byte0_vwum1 
    ldy bullet_add__1
    // sy >> 2
    // [52] bullet_add::$3 = bullet_add::sy >> 2 -- vwum1=vwum2_ror_2 
    lda sy+1
    lsr
    sta bullet_add__3+1
    lda sy
    ror
    sta bullet_add__3
    lsr bullet_add__3+1
    ror bullet_add__3
    // unsigned char asy = BYTE0(sy >> 2)
    // [53] bullet_add::asy#0 = byte0  bullet_add::$3 -- vbuxx=_byte0_vwum1 
    ldx bullet_add__3
    // tx >> 2
    // [54] bullet_add::$5 = bullet_add::tx >> 2 -- vwum1=vwum2_ror_2 
    lda tx+1
    lsr
    sta bullet_add__5+1
    lda tx
    ror
    sta bullet_add__5
    lsr bullet_add__5+1
    ror bullet_add__5
    // unsigned char atx = BYTE0(tx >> 2)
    // [55] bullet_add::atx#0 = byte0  bullet_add::$5 -- vbum1=_byte0_vwum2 
    lda bullet_add__5
    sta atx
    // ty >> 2
    // [56] bullet_add::$7 = bullet_add::ty >> 2 -- vwum1=vwum2_ror_2 
    lda ty+1
    lsr
    sta bullet_add__7+1
    lda ty
    ror
    sta bullet_add__7
    lsr bullet_add__7+1
    ror bullet_add__7
    // unsigned char aty = BYTE0(ty >> 2)
    // [57] bullet_add::aty#0 = byte0  bullet_add::$7 -- vbum1=_byte0_vwum2 
    lda bullet_add__7
    sta aty
    // unsigned char angle = math_atan2(asx, atx, asy, aty)
    // [58] bullet_add::math_atan21_x1 = bullet_add::asx#0 -- vbum1=vbuyy 
    sty math_atan21_x1
    // [59] bullet_add::math_atan21_x2 = bullet_add::atx#0 -- vbum1=vbum2 
    lda atx
    sta math_atan21_x2
    // [60] bullet_add::math_atan21_y1 = bullet_add::asy#0 -- vbum1=vbuxx 
    stx math_atan21_y1
    // [61] bullet_add::math_atan21_y2 = bullet_add::aty#0 -- vbum1=vbum2 
    lda aty
    sta math_atan21_y2
    // bullet_add::math_atan21
    // unsigned char octant_temp
    // [62] bullet_add::math_atan21_octant_temp = 0 -- vbum1=0 
    stz math_atan21_octant_temp
    // unsigned char angle
    // [63] bullet_add::math_atan21_angle = 0 -- vbum1=0 
    stz math_atan21_angle
    // asm
    // asm { lday2 sbcy1 bcs!+ eor#$ff !: tax roloctant_temp ldax1 sbcx2 bcs!+ eor#$ff !: tay roloctant_temp ldalogtab,x sbclogtab,y bcc!+ eor#$ff !: tax ldaoctant_temp rol and#%111 tay ldaatantab,x eoradjust_octant,y staangle  }
    sbc math_atan21_y1
    bcs !+
    eor #$ff
  !:
    tax
    rol math_atan21_octant_temp
    lda math_atan21_x1
    sbc math_atan21_x2
    bcs !+
    eor #$ff
  !:
    tay
    rol math_atan21_octant_temp
    lda logtab,x
    sbc logtab,y
    bcc !+
    eor #$ff
  !:
    tax
    lda math_atan21_octant_temp
    rol
    and #7
    tay
    lda atantab,x
    eor adjust_octant,y
    sta math_atan21_angle
    // return angle;
    // [65] bullet_add::math_atan21_return#0 = bullet_add::math_atan21_angle -- vbuaa=vbum1 
    // bullet_add::math_atan21_@return
    // }
    // [66] bullet_add::math_atan21_return#1 = bullet_add::math_atan21_return#0
    // bullet_add::@1
    // unsigned char angle = math_atan2(asx, atx, asy, aty)
    // [67] bullet_add::angle#0 = bullet_add::math_atan21_return#1
    // signed int dx = math_vecx(angle-16, speed)
    // [68] bullet_add::math_vecy1_angle#0 = bullet_add::angle#0 - $10 -- vbuxx=vbuaa_minus_vbuc1 
    sec
    sbc #$10
    tax
    // [69] bullet_add::math_vecx1_speed#0 = bullet_add::speed -- vbum1=vbum2 
    lda speed
    sta math_vecx1_speed
    // bullet_add::math_vecx1
    // if (speed)
    // [70] if(0==bullet_add::math_vecx1_speed#0) goto bullet_add::math_vecx1_@1 -- 0_eq_vbum1_then_la1 
    beq __b1
    // bullet_add::math_vecx1_@2
    // angle % 64

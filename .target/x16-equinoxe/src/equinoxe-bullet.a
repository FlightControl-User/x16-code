/**
 * @brief Get current x and y cursor position.
 * @return An unsigned int where the hi byte is the x coordinate and the low byte is the y coordinate of the screen position.
 */
// __mem() unsigned int cbm_k_plot_get()
cbm_k_plot_get: {
    // constants
    // variables
    // variables-zero-page
    // __mem unsigned char x
    // [157] cbm_k_plot_get::x = 0 -- vbum1=0 
    stz x
    // __mem unsigned char y
    // [158] cbm_k_plot_get::y = 0 -- vbum1=0 
    stz y
    // kickasm
    // kickasm( uses cbm_k_plot_get::x uses cbm_k_plot_get::y uses CBM_PLOT) {{ sec         jsr CBM_PLOT         stx y         sty x      }}
    sec
        jsr CBM_PLOT
        stx y
        sty x
    
    // MAKEWORD(x,y)
    // [160] cbm_k_plot_get::return#0 = cbm_k_plot_get::x w= cbm_k_plot_get::y -- vwum1=vbum2_word_vbum3 
    lda x
    sta return+1
    lda y
    sta return
    // cbm_k_plot_get::@return
    // }
    // [161] return 
    rts
  .segment Data
    x: .byte 0
  .segment Data
    y: .byte 0
  .segment Data
    return: .word 0
}

            "asm_begin": "  // code segment\n.segment Code\n  // uctoa\n// Converts unsigned number value to a string representing it in RADIX format.\n// If the leading digits are zero they are not included in the string.\n// - value : The number to be converted to RADIX\n// - buffer : receives the string representing the number and zero-termination.\n// - radix : The radix to convert the number to (from the enum RADIX)\n// void uctoa(__register(Y) char value, __zp($22) char *buffer, char radix)\nuctoa: {\n",
            "asm_constants": "  // constants\n  .const max_digits = 2\n",
            "asm_variables": "  // variables\n",
            "asm_end": "  // [297] phi from uctoa to uctoa::@1 [phi:uctoa->uctoa::@1]\n  // [297] phi uctoa::buffer#11 = (char *)&printf_buffer+OFFSET_STRUCT_PRINTF_BUFFER_NUMBER_DIGITS [phi:uctoa->uctoa::@1#0] -- pbuz1=pbuc1 \n  lda #<printf_buffer+OFFSET_STRUCT_PRINTF_BUFFER_NUMBER_DIGITS\n  sta.z buffer\n  lda #>printf_buffer+OFFSET_STRUCT_PRINTF_BUFFER_NUMBER_DIGITS\n  sta.z buffer+1\n  // [297] phi uctoa::started#2 = 0 [phi:uctoa->uctoa::@1#1] -- vbum1=vbuc1 \n  lda #0\n  sta started\n  // [297] phi uctoa::value#2 = uctoa::value#1 [phi:uctoa->uctoa::@1#2] -- register_copy \n  // [297] phi uctoa::digit#2 = 0 [phi:uctoa->uctoa::@1#3] -- vbuxx=vbuc1 \n  tax\n  // uctoa::@1\n__b1:\n  // [298] if(uctoa::digit#2<uctoa::max_digits#2-1) goto uctoa::@2 -- vbuxx_lt_vbuc1_then_la1 \n  cpx #max_digits-1\n  bcc __b2\n  // uctoa::@3\n  // [299] *uctoa::buffer#11 = DIGITS[uctoa::value#2] -- _deref_pbuz1=pbuc1_derefidx_vbuyy \n  lda DIGITS,y\n  ldy #0\n  sta (buffer),y\n  // [300] uctoa::buffer#3 = ++ uctoa::buffer#11 -- pbuz1=_inc_pbuz1 \n  inc.z buffer\n  bne !+\n  inc.z buffer+1\n!:\n  // [301] *uctoa::buffer#3 = 0 -- _deref_pbuz1=vbuc1 \n  lda #0\n  tay\n  sta (buffer),y\n  // uctoa::@return\n  // [302] return \n  rts\n  // uctoa::@2\n__b2:\n  // [303] uctoa::digit_value#0 = RADIX_HEXADECIMAL_VALUES_CHAR[uctoa::digit#2] -- vbum1=pbuc1_derefidx_vbuxx \n  lda RADIX_HEXADECIMAL_VALUES_CHAR,x\n  sta digit_value\n  // [304] if(0!=uctoa::started#2) goto uctoa::@5 -- 0_neq_vbum1_then_la1 \n  lda started\n  bne __b5\n  // uctoa::@7\n  // [305] if(uctoa::value#2>=uctoa::digit_value#0) goto uctoa::@5 -- vbuyy_ge_vbum1_then_la1 \n  cpy digit_value\n  bcs __b5\n  // [306] phi from uctoa::@7 to uctoa::@4 [phi:uctoa::@7->uctoa::@4]\n  // [306] phi uctoa::buffer#14 = uctoa::buffer#11 [phi:uctoa::@7->uctoa::@4#0] -- register_copy \n  // [306] phi uctoa::started#4 = uctoa::started#2 [phi:uctoa::@7->uctoa::@4#1] -- register_copy \n  // [306] phi uctoa::value#6 = uctoa::value#2 [phi:uctoa::@7->uctoa::@4#2] -- register_copy \n  // uctoa::@4\n__b4:\n  // [307] uctoa::digit#1 = ++ uctoa::digit#2 -- vbuxx=_inc_vbuxx \n  inx\n  // [297] phi from uctoa::@4 to uctoa::@1 [phi:uctoa::@4->uctoa::@1]\n  // [297] phi uctoa::buffer#11 = uctoa::buffer#14 [phi:uctoa::@4->uctoa::@1#0] -- register_copy \n  // [297] phi uctoa::started#2 = uctoa::started#4 [phi:uctoa::@4->uctoa::@1#1] -- register_copy \n  // [297] phi uctoa::value#2 = uctoa::value#6 [phi:uctoa::@4->uctoa::@1#2] -- register_copy \n  // [297] phi uctoa::digit#2 = uctoa::digit#1 [phi:uctoa::@4->uctoa::@1#3] -- register_copy \n  jmp __b1\n  // uctoa::@5\n__b5:\n  // [308] uctoa_append::buffer#0 = uctoa::buffer#11 -- pbuz1=pbuz2 \n  lda.z buffer\n  sta.z uctoa_append.buffer\n  lda.z buffer+1\n  sta.z uctoa_append.buffer+1\n  // [309] uctoa_append::value#0 = uctoa::value#2 -- vbum1=vbuyy \n  sty uctoa_append.value\n  // [310] uctoa_append::sub#0 = uctoa::digit_value#0\n  // [311] call uctoa_append\n  // [384] phi from uctoa::@5 to uctoa_append [phi:uctoa::@5->uctoa_append]\n  jsr uctoa_append\n  // [312] uctoa_append::return#0 = uctoa_append::value#2 -- vbuyy=vbum1 \n  ldy uctoa_append.value\n  // uctoa::@6\n  // [313] uctoa::value#0 = uctoa_append::return#0\n  // [314] uctoa::buffer#4 = ++ uctoa::buffer#11 -- pbuz1=_inc_pbuz1 \n  inc.z buffer\n  bne !+\n  inc.z buffer+1\n!:\n  // [306] phi from uctoa::@6 to uctoa::@4 [phi:uctoa::@6->uctoa::@4]\n  // [306] phi uctoa::buffer#14 = uctoa::buffer#4 [phi:uctoa::@6->uctoa::@4#0] -- register_copy \n  // [306] phi uctoa::started#4 = 1 [phi:uctoa::@6->uctoa::@4#1] -- vbum1=vbuc1 \n  lda #1\n  sta started\n  // [306] phi uctoa::value#6 = uctoa::value#0 [phi:uctoa::@6->uctoa::@4#2] -- register_copy \n  jmp __b4\n.segment Data\n  digit_value: .byte 0\n.segment Data\n  started: .byte 0\n}\n"

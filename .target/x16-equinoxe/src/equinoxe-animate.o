            "asm_end": "  // [261] rand::$0 = rand_state << 7 -- vwum1=vwum2_rol_7 \n  lda rand_state+1\n  lsr\n  lda rand_state\n  ror\n  sta rand__0+1\n  lda #0\n  ror\n  sta rand__0\n  // [262] rand_state = rand_state ^ rand::$0 -- vwum1=vwum1_bxor_vwum2 \n  lda rand_state\n  eor rand__0\n  sta rand_state\n  lda rand_state+1\n  eor rand__0+1\n  sta rand_state+1\n  // [263] rand::$1 = rand_state >> 9 -- vwum1=vwum2_ror_9 \n  lsr\n  sta rand__1\n  lda #0\n  sta rand__1+1\n  // [264] rand_state = rand_state ^ rand::$1 -- vwum1=vwum1_bxor_vwum2 \n  lda rand_state\n  eor rand__1\n  sta rand_state\n  lda rand_state+1\n  eor rand__1+1\n  sta rand_state+1\n  // [265] rand::$2 = rand_state << 8 -- vwum1=vwum2_rol_8 \n  lda rand_state\n  sta rand__2+1\n  lda #0\n  sta rand__2\n  // [266] rand_state = rand_state ^ rand::$2 -- vwum1=vwum1_bxor_vwum2 \n  lda rand_state\n  eor rand__2\n  sta rand_state\n  lda rand_state+1\n  eor rand__2+1\n  sta rand_state+1\n  // [267] rand::return#0 = rand_state -- vwum1=vwum2 \n  lda rand_state\n  sta return\n  lda rand_state+1\n  sta return+1\n  // rand::@return\n  // [268] return \n  rts\n.segment Data\n  rand__0: .word 0\n.segment Data\n  rand__1: .word 0\n.segment Data\n  rand__2: .word 0\n.segment Data\n  return: .word 0\n}\n"

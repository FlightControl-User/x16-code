            "asm_begin": "  // code segment\n.segment Code\n  // strlen\n// Computes the length of the string str up to but not including the terminating null character.\n// __mem() unsigned int strlen(__zp($24) char *str)\nstrlen: {\n",
            "asm_constants": "  // constants\n",

            "exported": false,
            "asm_begin": "  // code segment\n.segment Code\n  // cbm_k_plot_get\n/**\r\n * @brief Get current x and y cursor position.\r\n * @return An unsigned int where the hi byte is the x coordinate and the low byte is the y coordinate of the screen position.\r\n */\n// __mem() unsigned int cbm_k_plot_get()\ncbm_k_plot_get: {\n",
            "asm_constants": "  // constants\n",
            "asm_variables": "  // variables\n",
            "asm_end": "  // [155] cbm_k_plot_get::x = 0 -- vbum1=vbuc1 \n  lda #0\n  sta x\n  // [156] cbm_k_plot_get::y = 0 -- vbum1=vbuc1 \n  sta y\n  // kickasm( uses cbm_k_plot_get::x uses cbm_k_plot_get::y uses CBM_PLOT) {{ sec         jsr CBM_PLOT         stx y         sty x      }}\n  sec\n        jsr CBM_PLOT\n        stx y\n        sty x\n    \n  // [158] cbm_k_plot_get::return#0 = cbm_k_plot_get::x w= cbm_k_plot_get::y -- vwum1=vbum2_word_vbum3 \n  lda x\n  sta return+1\n  lda y\n  sta return\n  // cbm_k_plot_get::@return\n  // [159] return \n  rts\n.segment Data\n  x: .byte 0\n.segment Data\n  y: .byte 0\n.segment Data\n  return: .word 0\n}\n"
        },
        "rand": {
            "zp": {

            },
            "exported": false,
            "asm_begin": "  // code segment\n.segment Code\n  // rand\n// Returns a pseudo-random number in the range of 0 to RAND_MAX (65535)\n// Uses an xorshift pseudorandom number generator that hits all different values\n// Information https://en.wikipedia.org/wiki/Xorshift\n// Source http://www.retroprogramming.com/2017/07/xorshift-pseudorandom-numbers-in-z80.html\n// __mem() unsigned int rand()\nrand: {\n",
            "asm_constants": "  // constants\n",
            "asm_variables": "  // variables\n",
            "asm_end": "  // [133] rand::$0 = rand_state << 7 -- vwum1=vwum2_rol_7 \n  lda rand_state+1\n  lsr\n  lda rand_state\n  ror\n  sta rand__0+1\n  lda #0\n  ror\n  sta rand__0\n  // [134] rand_state = rand_state ^ rand::$0 -- vwum1=vwum1_bxor_vwum2 \n  lda rand_state\n  eor rand__0\n  sta rand_state\n  lda rand_state+1\n  eor rand__0+1\n  sta rand_state+1\n  // [135] rand::$1 = rand_state >> 9 -- vwum1=vwum2_ror_9 \n  lsr\n  sta rand__1\n  lda #0\n  sta rand__1+1\n  // [136] rand_state = rand_state ^ rand::$1 -- vwum1=vwum1_bxor_vwum2 \n  lda rand_state\n  eor rand__1\n  sta rand_state\n  lda rand_state+1\n  eor rand__1+1\n  sta rand_state+1\n  // [137] rand::$2 = rand_state << 8 -- vwum1=vwum2_rol_8 \n  lda rand_state\n  sta rand__2+1\n  lda #0\n  sta rand__2\n  // [138] rand_state = rand_state ^ rand::$2 -- vwum1=vwum1_bxor_vwum2 \n  lda rand_state\n  eor rand__2\n  sta rand_state\n  lda rand_state+1\n  eor rand__2+1\n  sta rand_state+1\n  // [139] rand::return#0 = rand_state -- vwum1=vwum2 \n  lda rand_state\n  sta return\n  lda rand_state+1\n  sta return+1\n  // rand::@return\n  // [140] return \n  rts\n.segment Data\n  rand__0: .word 0\n.segment Data\n  rand__1: .word 0\n.segment Data\n  rand__2: .word 0\n.segment Data\n  return: .word 0\n}\n"
        },

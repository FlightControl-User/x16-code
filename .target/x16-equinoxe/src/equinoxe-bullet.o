            "asm_begin": "  // code segment\n.segment CodeEngineBullets\n  // bullet_add\n// __mem() char equinoxe_bullet.bullet_add(__mem() unsigned int sx, __mem() unsigned int sy, __mem() unsigned int tx, __mem() unsigned int ty, __mem() char speed, __mem() char side, __mem() char sprite_bullet)\n// __bank(cx16_ram, 7) \nbullet_add: {\n",
            "asm_constants": "  // constants\n",
            "asm_variables": "  // variables\n",
            "asm_end": "  // [45] flight_add::type = 3 -- vbum1=vbuc1 \n  lda #3\n  sta equinoxe_flightengine.flight_add.type\n  // [46] flight_add::side = bullet_add::side -- vbum1=vbum2 \n  lda side\n  sta equinoxe_flightengine.flight_add.side\n  // [47] flight_add::sprite = bullet_add::sprite_bullet -- vbum1=vbum2 \n  lda sprite_bullet\n  sta equinoxe_flightengine.flight_add.sprite\n  // [48] callexecute flight_add  -- call_var_near \n  jsr equinoxe_flightengine.flight_add\n  // [49] bullet_add::b#0 = flight_add::return -- vbum1=vbum2 \n  lda equinoxe_flightengine.flight_add.return\n  sta b\n  // [50] bullet_add::$1 = bullet_add::sx >> 2 -- vwum1=vwum2_ror_2 \n  lda sx+1\n  lsr\n  sta bullet_add__1+1\n  lda sx\n  ror\n  sta bullet_add__1\n  lsr bullet_add__1+1\n  ror bullet_add__1\n  // [51] bullet_add::asx#0 = byte0  bullet_add::$1 -- vbuyy=_byte0_vwum1 \n  ldy bullet_add__1\n  // [52] bullet_add::$3 = bullet_add::sy >> 2 -- vwum1=vwum2_ror_2 \n  lda sy+1\n  lsr\n  sta bullet_add__3+1\n  lda sy\n  ror\n  sta bullet_add__3\n  lsr bullet_add__3+1\n  ror bullet_add__3\n  // [53] bullet_add::asy#0 = byte0  bullet_add::$3 -- vbuxx=_byte0_vwum1 \n  ldx bullet_add__3\n  // [54] bullet_add::$5 = bullet_add::tx >> 2 -- vwum1=vwum2_ror_2 \n  lda tx+1\n  lsr\n  sta bullet_add__5+1\n  lda tx\n  ror\n  sta bullet_add__5\n  lsr bullet_add__5+1\n  ror bullet_add__5\n  // [55] bullet_add::atx#0 = byte0  bullet_add::$5 -- vbum1=_byte0_vwum2 \n  lda bullet_add__5\n  sta atx\n  // [56] bullet_add::$7 = bullet_add::ty >> 2 -- vwum1=vwum2_ror_2 \n  lda ty+1\n  lsr\n  sta bullet_add__7+1\n  lda ty\n  ror\n  sta bullet_add__7\n  lsr bullet_add__7+1\n  ror bullet_add__7\n  // [57] bullet_add::aty#0 = byte0  bullet_add::$7 -- vbum1=_byte0_vwum2 \n  lda bullet_add__7\n  sta aty\n  // [58] bullet_add::math_atan21_x1 = bullet_add::asx#0 -- vbum1=vbuyy \n  sty math_atan21_x1\n  // [59] bullet_add::math_atan21_x2 = bullet_add::atx#0 -- vbum1=vbum2 \n  lda atx\n  sta math_atan21_x2\n  // [60] bullet_add::math_atan21_y1 = bullet_add::asy#0 -- vbum1=vbuxx \n  stx math_atan21_y1\n  // [61] bullet_add::math_atan21_y2 = bullet_add::aty#0 -- vbum1=vbum2 \n  lda aty\n  sta math_atan21_y2\n  // bullet_add::math_atan21\n  // [62] bullet_add::math_atan21_octant_temp = 0 -- vbum1=vbuc1 \n  lda #0\n  sta math_atan21_octant_temp\n  // [63] bullet_add::math_atan21_angle = 0 -- vbum1=vbuc1 \n  sta math_atan21_angle\n  // asm { lday2 sbcy1 bcs!+ eor#$ff !: tax roloctant_temp ldax1 sbcx2 bcs!+ eor#$ff !: tay roloctant_temp ldalogtab,x sbclogtab,y bcc!+ eor#$ff !: tax ldaoctant_temp rol and#%111 tay ldaatantab,x eoradjust_octant,y staangle  }\n  lda math_atan21_y2\n  sbc math_atan21_y1\n  bcs !+\n  eor #$ff\n!:\n  tax\n  rol math_atan21_octant_temp\n  lda math_atan21_x1\n  sbc math_atan21_x2\n  bcs !+\n  eor #$ff\n!:\n  tay\n  rol math_atan21_octant_temp\n  lda logtab,x\n  sbc logtab,y\n  bcc !+\n  eor #$ff\n!:\n  tax\n  lda math_atan21_octant_temp\n  rol\n  and #7\n  tay\n  lda atantab,x\n  eor adjust_octant,y\n  sta math_atan21_angle\n  // [65] bullet_add::math_atan21_return#0 = bullet_add::math_atan21_angle -- vbuaa=vbum1 \n  // bullet_add::math_atan21_@return\n  // [66] bullet_add::math_atan21_return#1 = bullet_add::math_atan21_return#0\n  // bullet_add::@1\n  // [67] bullet_add::angle#0 = bullet_add::math_atan21_return#1\n  // [68] bullet_add::math_vecy1_angle#0 = bullet_add::angle#0 - $10 -- vbuxx=vbuaa_minus_vbuc1 \n  sec\n  sbc #$10\n  tax\n  // [69] bullet_add::math_vecx1_speed#0 = bullet_add::speed -- vbum1=vbum2 \n  lda speed\n  sta math_vecx1_speed\n  // bullet_add::math_vecx1\n  // [70] if(0==bullet_add::math_vecx1_speed#0) goto bullet_add::math_vecx1_@1 -- 0_eq_vbum1_then_la1 \n  beq __b1\n  // bullet_add::math_vecx1_@2\n  // [71] bullet_add::math_vecx1_$1 = bullet_add::math_vecy1_angle#0 & $40-1 -- vbuaa=vbuxx_band_vbuc1 \n  txa\n  and #$40-1\n  // [72] bullet_add::math_vecx1_$2 = bullet_add::math_vecx1_$1 << 1 -- vbuaa=vbuaa_rol_1 \n  asl\n  // [73] bulle
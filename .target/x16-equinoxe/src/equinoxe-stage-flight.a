    // stage.enemy_count--;
    // [14] *((char *)&stage+OFFSET_STRUCT_STAGE_T_ENEMY_COUNT) = -- *((char *)&stage+OFFSET_STRUCT_STAGE_T_ENEMY_COUNT) -- _deref_pbuc1=_dec__deref_pbuc1 

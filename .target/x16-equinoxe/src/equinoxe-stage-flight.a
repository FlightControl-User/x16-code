.segment CodeEngineStages
  // stage_impact
// void equinoxe_stage_flight.stage_impact(__mem() char f, __mem() char h)
// __bank(cx16_ram, 3) 
stage_impact: {
    // constants
    // variables
    // variables-zero-page
    // flight_impact(h)
    // [83] flight_impact::f = stage_impact::h -- vbum1=vbum2 
    lda h
    sta equinoxe_flightengine.flight_impact.f
    // [84] callexecute flight_impact  -- call_var_near 
    jsr equinoxe_flightengine.flight_impact
    // [85] stage_impact::$0 = flight_impact::return -- vbsxx=vbsm1 
    ldx equinoxe_flightengine.flight_impact.return
    // unsigned char hit = flight_hit(f, flight_impact(h))
    // [86] flight_hit::f = stage_impact::f -- vbum1=vbum2 
    lda f
    sta equinoxe_flightengine.flight_hit.f
    // [87] flight_hit::impact = stage_impact::$0 -- vbsm1=vbsxx 
    stx equinoxe_flightengine.flight_hit.impact
    // [88] callexecute flight_hit  -- call_var_near 
    jsr equinoxe_flightengine.flight_hit
    // [89] stage_impact::hit#0 = flight_hit::return -- vbuaa=vbum1 
    lda equinoxe_flightengine.flight_hit.return
    // if(hit)
    // [90] if(0==stage_impact::hit#0) goto stage_impact::@return -- 0_eq_vbuaa_then_la1 
    cmp #0
    beq __breturn
    // stage_impact::@1
    // case FLIGHT_ENEMY:
    //                 stage_enemy_remove(flight_wave(f), f);
    //                 break;
    // [91] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_TYPE)[stage_impact::f]==1) goto stage_impact::@5 -- pbuc1_derefidx_vbum1_eq_vbuc2_then_la1 
    ldy f
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_TYPE,y
    cmp #1
    beq __b5
    // stage_impact::@2
    // case FLIGHT_BULLET:
    //                 stage_bullet_remove(f);
    //                 break;
    // [92] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_TYPE)[stage_impact::f]==3) goto stage_impact::@6 -- pbuc1_derefidx_vbum1_eq_vbuc2_then_la1 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_TYPE,y
    cmp #3
    beq __b6
    // stage_impact::@3
    // case FLIGHT_PLAYER:
    //                 stage_player_remove(f);
    //                 break;
    // [93] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_TYPE)[stage_impact::f]==0) goto stage_impact::@7 -- pbuc1_derefidx_vbum1_eq_0_then_la1 
    lda equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_TYPE,y
    cmp #0
    beq __b7
    // stage_impact::@4
    // case FLIGHT_TOWER:
    //                 stage_tower_remove(f);
    //                 break;
    // [94] if(((char *)&flight+OFFSET_STRUCT_FLIGHT_T_TYPE)[stage_impact::f]!=2) goto stage_impact::@return -- pbuc1_derefidx_vbum1_neq_vbuc2_then_la1 
    lda #2
    cmp equinoxe_flightengine.flight+OFFSET_STRUCT_FLIGHT_T_TYPE,y
    bne __breturn
    // stage_impact::@8
    // stage_tower_remove(f)
    // [95] stage_tower_remove::t = stage_impact::f -- vbum1=vbum2 
    tya
    sta stage_tower_remove.t
    // [96] callexecute stage_tower_remove  -- call_var_near 
    jsr equinoxe_stage_flight.stage_tower_remove
    // stage_impact::@return
  __breturn:
    // }
    // [97] return 
    rts
    // stage_impact::@7
  __b7:
    // stage_player_remove(f)
    // [98] stage_player_remove::p = stage_impact::f -- vbum1=vbum2 
    lda f
    sta stage_player_remove.p
    // [99] callexecute stage_player_remove  -- call_var_near 
    jsr equinoxe_stage_flight.stage_player_remove
    rts
    // stage_impact::@6
  __b6:
    // stage_bullet_remove(f)
    // [100] stage_bullet_remove::b = stage_impact::f -- vbum1=vbum2 
    lda f
    sta stage_bullet_remove.b
    // [101] callexecute stage_bullet_remove  -- call_var_near 
    jsr equinoxe_stage_flight.stage_bullet_remove
    rts
    // stage_impact::@5
  __b5:
    // flight_wave(f)
    // [102] flight_wave::f = stage_impact::f -- vbum1=vbum2 
    lda f
    sta equinoxe_flightengine.flight_wave.f
    // [103] callexecute flight_wave  -- call_var_near 
    jsr equinoxe_flightengine.flight_wave
    // [104] stage_impact::$3 = flight_wave::return -- vbuaa=vbum1 
    lda equinoxe_flightengine.flight_wave.return
    // stage_enemy_remove(flight_wave(f), f)
    // [105] stage_enemy_remove::w = stage_impact::$3 -- vbum1=vbuaa 
    sta stage_enemy_remove.w
    // [106] stage_enemy_remove::e = stage_impact::f -- vbum1=vbum2 
    lda f
    sta stage_enemy_remove.e
    // [107] callexecute stage_enemy_remove  -- call_var_near 
    jsr equinoxe_stage_flight.stage_enemy_remove
    rts
  .segment Data
    f: .byte 0
  .segment Data
    h: .byte 0
}

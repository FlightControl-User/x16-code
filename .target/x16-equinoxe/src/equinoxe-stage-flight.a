.segment CodeEngineStages
  // stage_bullet_add
// void equinoxe_stage_flight.stage_bullet_add(__mem() unsigned int sx, __mem() unsigned int sy, __mem() unsigned int tx, __mem() unsigned int ty, __mem() char speed, __mem() char side, __mem() char sprite_bullet)
// __bank(cx16_ram, 3) 
stage_bullet_add: {
    // constants
    // variables
    // variables-zero-page
    // bullet_add(sx, sy, tx, ty, speed, side, sprite_bullet)
    // [73] bullet_add::sx = stage_bullet_add::sx -- vwum1=vwum2 
    lda sx
    sta equinoxe_bullet.bullet_add.sx
    lda sx+1
    sta equinoxe_bullet.bullet_add.sx+1
    // [74] bullet_add::sy = stage_bullet_add::sy -- vwum1=vwum2 
    lda sy
    sta equinoxe_bullet.bullet_add.sy
    lda sy+1
    sta equinoxe_bullet.bullet_add.sy+1
    // [75] bullet_add::tx = stage_bullet_add::tx -- vwum1=vwum2 
    lda tx
    sta equinoxe_bullet.bullet_add.tx
    lda tx+1
    sta equinoxe_bullet.bullet_add.tx+1
    // [76] bullet_add::ty = stage_bullet_add::ty -- vwum1=vwum2 
    lda ty
    sta equinoxe_bullet.bullet_add.ty
    lda ty+1
    sta equinoxe_bullet.bullet_add.ty+1
    // [77] bullet_add::speed = stage_bullet_add::speed -- vbum1=vbum2 
    lda speed
    sta equinoxe_bullet.bullet_add.speed
    // [78] bullet_add::side = stage_bullet_add::side -- vbum1=vbum2 
    lda side
    sta equinoxe_bullet.bullet_add.side
    // [79] bullet_add::sprite_bullet = stage_bullet_add::sprite_bullet -- vbum1=vbum2 
    lda sprite_bullet
    sta equinoxe_bullet.bullet_add.sprite_bullet
    // [80] callexecute bullet_add  -- call_var_far_cx16_ram 
    jsr $ff6e
    .byte <equinoxe_bullet.bullet_add
    .byte >equinoxe_bullet.bullet_add
    .byte 7
    // stage.bullet_count++;
    // [81] *((char *)&stage+OFFSET_STRUCT_STAGE_T_BULLET_COUNT) = ++ *((char *)&stage+OFFSET_STRUCT_STAGE_T_BULLET_COUNT) -- _deref_pbuc1=_inc__deref_pbuc1 
    inc stage+OFFSET_STRUCT_STAGE_T_BULLET_COUNT
    // stage_bullet_add::@return
    // }
    // [82] return 
    rts
